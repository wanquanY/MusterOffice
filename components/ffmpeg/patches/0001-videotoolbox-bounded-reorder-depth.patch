+#if CONFIG_H264_VIDEOTOOLBOX_ENCODER
+    /* MusterOffice: modern hardware can emit hierarchical H.264 B pictures.
+     * AllowFrameReordering is only a boolean. Derive the bounded reorder depth
+     * from the actual SPS (including its standard level-derived fallback), not
+     * a guessed one-frame latency. The fixed component uses global headers. */
+    if (avctx->codec_id == AV_CODEC_ID_H264 && vtctx->has_b_frames &&
+        (avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER)) {
+        H264ParamSets ps = { 0 };
+        int is_avc, nal_length_size, depth = -1;
+        int ret = ff_h264_decode_extradata(avctx->extradata, avctx->extradata_size,
+                                           &ps, &is_avc, &nal_length_size,
+                                           AV_EF_EXPLODE, avctx);
+        if (ret >= 0) {
+            for (int i = 0; i < MAX_SPS_COUNT; i++)
+                if (ps.sps_list[i])
+                    depth = FFMAX(depth, ps.sps_list[i]->num_reorder_frames);
+        }
+        ff_h264_ps_uninit(&ps);
+        if (ret < 0 || depth < 0 || depth > 16)
+            return ret < 0 ? ret : AVERROR_INVALIDDATA;
+        vtctx->has_b_frames = depth;
+    }
+#endif
+    vtctx->dts_delta = vtctx->has_b_frames ? -1 : 0;
     avctx->has_b_frames = vtctx->has_b_frames;
 
     return 0;
