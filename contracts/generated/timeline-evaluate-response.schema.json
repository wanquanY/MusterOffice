{
  "$id": "urn:musteroffice:runtime:0.1-draft:timeline-evaluate-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineEvaluateResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "frame": {
          "$ref": "#/$defs/EvaluatedFrame"
        },
        "status": {
          "type": "string",
          "const": "evaluated"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "frame"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/TimelineFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "EvaluatedFrame": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "state": {
          "$ref": "#/$defs/FrameState"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "sha256"
      ]
    },
    "ExactMotion": {
      "description": "Position offsets in fractions of the slide width/height. Ratios encode the\ncomputed position exactly; the frame profile states any path approximation.",
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/ExactValue"
        },
        "y": {
          "$ref": "#/$defs/ExactValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "ExactRotation": {
      "description": "An exact angle with its document dependency still explicit. The layout\norientation is resolved only at placement, after source inheritance.",
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/RotationBasis"
        },
        "denominator": {
          "type": "string"
        },
        "numerator": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "ExactScale": {
      "description": "Scale values remain thousandths of a percent until the placement boundary.",
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/ExactValue"
        },
        "y": {
          "$ref": "#/$defs/ExactValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "ExactValue": {
      "description": "Output-only exact reduced ratio. Units are defined by each property channel.",
      "type": "object",
      "properties": {
        "denominator": {
          "type": "string"
        },
        "numerator": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "FrameState": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeFrame"
          }
        },
        "eventCursor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "motion": {
          "description": "Exact slide-relative offsets from the original layout center.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "$ref": "#/$defs/ExactMotion"
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeFrame"
          }
        },
        "opacity": {
          "description": "Exact whole-object opacity in [0, 1], before one render-boundary rounding.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "$ref": "#/$defs/ExactValue"
            }
          }
        },
        "presentationStep": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresentationStepReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "type": "string"
        },
        "rotations": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "$ref": "#/$defs/ExactRotation"
            }
          }
        },
        "scales": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "$ref": "#/$defs/ExactScale"
            }
          }
        },
        "sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequenceFrame"
          }
        },
        "time": {
          "$ref": "#/$defs/RationalTime"
        },
        "timelineSha256": {
          "$ref": "#/$defs/Digest"
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "$ref": "#/$defs/Visibility"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "binding",
        "timelineSha256",
        "time",
        "eventCursor",
        "nodes",
        "rotations"
      ]
    },
    "NavigationDirection": {
      "type": "string",
      "enum": [
        "next",
        "previous"
      ]
    },
    "NodeFrame": {
      "type": "object",
      "properties": {
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "iteration": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "$ref": "#/$defs/TimingNodeId"
        },
        "phase": {
          "$ref": "#/$defs/NodePhase"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "phase"
      ]
    },
    "NodePhase": {
      "type": "string",
      "enum": [
        "waiting",
        "scheduled",
        "active",
        "frozen",
        "finished",
        "suppressed"
      ]
    },
    "PlaybackBinding": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/$defs/PlaybackGeneration"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "session": {
          "$ref": "#/$defs/PlaybackSessionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "revision",
        "generation"
      ]
    },
    "PlaybackGeneration": {
      "description": "Canonical uint64 playback generation; never wraps.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615"
    },
    "PlaybackSessionId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "PresentationPageEntry": {
      "oneOf": [
        {
          "description": "A new page owner with time zero and an empty input prefix. Previous does\nnot synthesize a terminal pose or guess clicks on an unbounded timeline.",
          "type": "string",
          "const": "initial"
        }
      ]
    },
    "PresentationStepOutcome": {
      "oneOf": [
        {
          "description": "An eligible page condition admitted this event, including delayed work.\nThis remains consumed even if a later event cancels that scheduled work.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "consumed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "No eligible page condition admitted this event. The presentation host\nmay cross the requested boundary, using this kernel-defined entry state.",
          "type": "object",
          "properties": {
            "entry": {
              "$ref": "#/$defs/PresentationPageEntry"
            },
            "kind": {
              "type": "string",
              "const": "pageBoundary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entry"
          ]
        }
      ]
    },
    "PresentationStepReceipt": {
      "description": "The last presentation step in the sampled, validated event prefix. The\nenclosing frame binds document/session/generation and hashes this receipt.",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/ExactValue"
        },
        "direction": {
          "$ref": "#/$defs/NavigationDirection"
        },
        "outcome": {
          "$ref": "#/$defs/PresentationStepOutcome"
        },
        "sequence": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sequence",
        "at",
        "direction",
        "outcome"
      ]
    },
    "RationalTime": {
      "description": "Exact wire representation. Equality compares author values; compare_time compares instants.",
      "type": "object",
      "properties": {
        "ticks": {
          "$ref": "#/$defs/Ticks"
        },
        "timescale": {
          "$ref": "#/$defs/Timescale"
        }
      },
      "additionalProperties": false,
      "required": [
        "ticks",
        "timescale"
      ]
    },
    "RotationBasis": {
      "type": "string",
      "enum": [
        "absolute",
        "layout"
      ]
    },
    "SequenceFrame": {
      "type": "object",
      "properties": {
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimingNodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "$ref": "#/$defs/TimingNodeId"
        },
        "position": {
          "description": "Zero-based cursor. The child count denotes the position after the end.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "position"
      ]
    },
    "Ticks": {
      "description": "Signed int64 ticks. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "TimelineFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/TimelineFailureCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "TimelineFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "REVISION_CONFLICT",
        "EVENT_HISTORY_REQUIRED",
        "EVENT_HISTORY_INVALID",
        "LIMIT_EXCEEDED",
        "CANCELLED"
      ]
    },
    "Timescale": {
      "type": "integer",
      "maximum": 1000000000,
      "minimum": 1
    },
    "TimingNodeId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Visibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ]
    }
  }
}
