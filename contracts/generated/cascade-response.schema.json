{
  "$id": "urn:musteroffice:runtime:0.1-draft:cascade-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CascadeResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/CascadeResult"
        },
        "status": {
          "type": "string",
          "const": "evaluated"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ShapeFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "CascadeResult": {
      "type": "object",
      "properties": {
        "contextScalars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemSelection"
          }
        },
        "probedGlyphs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "shapingCalls": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "verifiedFaces": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "items",
        "verifiedFaces",
        "shapingCalls",
        "contextScalars",
        "probedGlyphs"
      ]
    },
    "CoverageOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "glyphId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "mapped"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "glyphId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unsupportedVariation"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "noUnicodeCmap"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Direction": {
      "type": "string",
      "enum": [
        "leftToRight",
        "rightToLeft",
        "topToBottom",
        "bottomToTop"
      ]
    },
    "EffectiveVariation": {
      "type": "object",
      "properties": {
        "effectiveF32Bits": {
          "description": "Effective IEEE754 binary32 design coordinate. Rounding is explicit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "requested1616": {
          "type": "integer",
          "format": "int32"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "requested1616",
        "effectiveF32Bits"
      ]
    },
    "FontAttempt": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "font": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "missingGlyphClusters": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "variationIssues": {
          "description": "Conservative cmap-14 evidence, not proof of GSUB-only selector handling.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariationIssue"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "candidate",
        "font",
        "missingGlyphClusters",
        "variationIssues"
      ]
    },
    "FontSelectionFailure": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "$ref": "#/$defs/FontStyle"
        },
        "reason": {
          "$ref": "#/$defs/FontSelectionReason"
        },
        "style": {
          "description": "Index in the actual ManifestParagraphInput.styles, not a native run id.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "typeface": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "style",
        "typeface",
        "fontStyle",
        "reason"
      ]
    },
    "FontSelectionReason": {
      "type": "string",
      "enum": [
        "unmappedTypeface",
        "missingStyle"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "regular",
        "bold",
        "italic",
        "boldItalic"
      ]
    },
    "ItemSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FontAttempt"
              }
            },
            "candidate": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "font": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "shaped": {
              "$ref": "#/$defs/ShapedText"
            },
            "status": {
              "type": "string",
              "const": "selected"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "font",
            "candidate",
            "shaped",
            "attempts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FontAttempt"
              }
            },
            "end": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "start": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "unresolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "start",
            "end",
            "attempts"
          ]
        }
      ]
    },
    "ShapeFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ShapeFailureCode"
        },
        "fontSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontSelectionFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ShapeFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "FONT_INVALID",
        "UNSUPPORTED",
        "RESOURCE_CONFLICT",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "COMPONENT_FAILURE",
        "COMPONENT_INVALID",
        "HOST_FAILURE"
      ]
    },
    "ShapedGlyph": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glyphId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "safeToInsertTatweel": {
          "type": "boolean"
        },
        "unsafeToBreak": {
          "type": "boolean"
        },
        "unsafeToConcat": {
          "type": "boolean"
        },
        "xAdvance": {
          "type": "integer",
          "format": "int32"
        },
        "xOffset": {
          "type": "integer",
          "format": "int32"
        },
        "yAdvance": {
          "type": "integer",
          "format": "int32"
        },
        "yOffset": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "glyphId",
        "cluster",
        "unsafeToBreak",
        "unsafeToConcat",
        "safeToInsertTatweel",
        "xAdvance",
        "yAdvance",
        "xOffset",
        "yOffset"
      ]
    },
    "ShapedRun": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "effectiveVariations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectiveVariation"
          }
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glyphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapedGlyph"
          }
        },
        "missingGlyphClusters": {
          "description": "A computational success may still contain missing glyphs; never hide it.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "direction",
        "effectiveVariations",
        "missingGlyphClusters",
        "glyphs"
      ]
    },
    "ShapedText": {
      "type": "object",
      "properties": {
        "faceIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fontSha256": {
          "$ref": "#/$defs/Digest"
        },
        "positionUnitsPerEm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapedRun"
          }
        },
        "unitsPerEm": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fontSha256",
        "faceIndex",
        "unitsPerEm",
        "positionUnitsPerEm",
        "profile",
        "runs"
      ]
    },
    "VariationIssue": {
      "type": "object",
      "properties": {
        "baseOffset": {
          "description": "None for a selector without an immediately preceding non-selector scalar.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/CoverageOutcome"
        },
        "selectorOffset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "selectorOffset",
        "outcome"
      ]
    }
  }
}
