{
  "$id": "urn:musteroffice:runtime:0.1-draft:video-pcm-tile-ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PcmTileRef",
  "type": "object",
  "properties": {
    "byteLength": {
      "$ref": "#/$defs/ByteLength"
    },
    "firstSample": {
      "$ref": "#/$defs/Ticks"
    },
    "frames": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sha256": {
      "$ref": "#/$defs/Digest"
    },
    "source": {
      "$ref": "#/$defs/Digest"
    }
  },
  "additionalProperties": false,
  "required": [
    "source",
    "index",
    "firstSample",
    "frames",
    "sha256",
    "byteLength"
  ],
  "$defs": {
    "ByteLength": {
      "description": "Canonical uint64 byte length. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615",
      "x-integer-minimum": "0"
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Ticks": {
      "description": "Signed int64 ticks. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    }
  }
}
