{
  "$id": "urn:musteroffice:runtime:0.1-draft:font-carets-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FontCaretsResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "carets": {
          "$ref": "#/$defs/FontCaretsResult"
        },
        "status": {
          "type": "string",
          "const": "queried"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "carets"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ShapeFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Direction": {
      "type": "string",
      "enum": [
        "leftToRight",
        "rightToLeft",
        "topToBottom",
        "bottomToTop"
      ]
    },
    "EffectiveVariation": {
      "type": "object",
      "properties": {
        "effectiveF32Bits": {
          "description": "Effective IEEE754 binary32 design coordinate. Rounding is explicit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "requested1616": {
          "type": "integer",
          "format": "int32"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "requested1616",
        "effectiveF32Bits"
      ]
    },
    "FontCaretsResult": {
      "type": "object",
      "properties": {
        "faceIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fontSha256": {
          "$ref": "#/$defs/Digest"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeasuredCarets"
          }
        },
        "positionUnitsPerEm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "unitsPerEm": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fontSha256",
        "faceIndex",
        "unitsPerEm",
        "positionUnitsPerEm",
        "profile",
        "instances"
      ]
    },
    "FontSelectionFailure": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "$ref": "#/$defs/FontStyle"
        },
        "reason": {
          "$ref": "#/$defs/FontSelectionReason"
        },
        "style": {
          "description": "Index in the actual ManifestParagraphInput.styles, not a native run id.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "typeface": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "style",
        "typeface",
        "fontStyle",
        "reason"
      ]
    },
    "FontSelectionReason": {
      "type": "string",
      "enum": [
        "unmappedTypeface",
        "missingStyle"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "regular",
        "bold",
        "italic",
        "boldItalic"
      ]
    },
    "GlyphCarets": {
      "type": "object",
      "properties": {
        "glyphId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "positions": {
          "description": "GDEF positions in the font's order, before shaping placement/kerning.\nEmpty means the font supplies no carets; zero is a real position.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "glyphId",
        "positions"
      ]
    },
    "MeasuredCarets": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "effectiveVariations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectiveVariation"
          }
        },
        "glyphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GlyphCarets"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "effectiveVariations",
        "direction",
        "glyphs"
      ]
    },
    "ShapeFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ShapeFailureCode"
        },
        "fontSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontSelectionFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ShapeFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "FONT_INVALID",
        "UNSUPPORTED",
        "RESOURCE_CONFLICT",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "COMPONENT_FAILURE",
        "COMPONENT_INVALID",
        "HOST_FAILURE"
      ]
    }
  }
}
