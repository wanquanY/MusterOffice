{
  "$id": "urn:musteroffice:runtime:0.1-draft:shape-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShapeResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "shaped"
        },
        "text": {
          "$ref": "#/$defs/ShapedText"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ShapeFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Direction": {
      "type": "string",
      "enum": [
        "leftToRight",
        "rightToLeft",
        "topToBottom",
        "bottomToTop"
      ]
    },
    "EffectiveVariation": {
      "type": "object",
      "properties": {
        "effectiveF32Bits": {
          "description": "Effective IEEE754 binary32 design coordinate. Rounding is explicit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "requested1616": {
          "type": "integer",
          "format": "int32"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "requested1616",
        "effectiveF32Bits"
      ]
    },
    "FontSelectionFailure": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "$ref": "#/$defs/FontStyle"
        },
        "reason": {
          "$ref": "#/$defs/FontSelectionReason"
        },
        "style": {
          "description": "Index in the actual ManifestParagraphInput.styles, not a native run id.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "typeface": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "style",
        "typeface",
        "fontStyle",
        "reason"
      ]
    },
    "FontSelectionReason": {
      "type": "string",
      "enum": [
        "unmappedTypeface",
        "missingStyle"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "regular",
        "bold",
        "italic",
        "boldItalic"
      ]
    },
    "ShapeFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ShapeFailureCode"
        },
        "fontSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontSelectionFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ShapeFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "FONT_INVALID",
        "UNSUPPORTED",
        "RESOURCE_CONFLICT",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "COMPONENT_FAILURE",
        "COMPONENT_INVALID",
        "HOST_FAILURE"
      ]
    },
    "ShapedGlyph": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glyphId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "safeToInsertTatweel": {
          "type": "boolean"
        },
        "unsafeToBreak": {
          "type": "boolean"
        },
        "unsafeToConcat": {
          "type": "boolean"
        },
        "xAdvance": {
          "type": "integer",
          "format": "int32"
        },
        "xOffset": {
          "type": "integer",
          "format": "int32"
        },
        "yAdvance": {
          "type": "integer",
          "format": "int32"
        },
        "yOffset": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "glyphId",
        "cluster",
        "unsafeToBreak",
        "unsafeToConcat",
        "safeToInsertTatweel",
        "xAdvance",
        "yAdvance",
        "xOffset",
        "yOffset"
      ]
    },
    "ShapedRun": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "effectiveVariations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectiveVariation"
          }
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glyphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapedGlyph"
          }
        },
        "missingGlyphClusters": {
          "description": "A computational success may still contain missing glyphs; never hide it.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "direction",
        "effectiveVariations",
        "missingGlyphClusters",
        "glyphs"
      ]
    },
    "ShapedText": {
      "type": "object",
      "properties": {
        "faceIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fontSha256": {
          "$ref": "#/$defs/Digest"
        },
        "positionUnitsPerEm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapedRun"
          }
        },
        "unitsPerEm": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fontSha256",
        "faceIndex",
        "unitsPerEm",
        "positionUnitsPerEm",
        "profile",
        "runs"
      ]
    }
  }
}
