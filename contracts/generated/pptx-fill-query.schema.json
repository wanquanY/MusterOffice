{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-fill-query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceFillQuery",
  "type": "object",
  "properties": {
    "expectedSourceSha256": {
      "$ref": "#/$defs/Digest"
    },
    "profile": {
      "$ref": "#/$defs/FillProfile"
    },
    "surface": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FillTarget"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "expectedSourceSha256",
    "surface",
    "targets",
    "profile"
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "FillProfile": {
      "description": "An explicit interpretation, not a certificate for any Office/WPS version.",
      "type": "string",
      "enum": [
        "ms-oi29500-fills-2024-draft-v1"
      ]
    },
    "FillTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "line"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "picture"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId"
          ]
        },
        {
          "description": "Physical cell formatting. Covered cells remain queryable; page painting\nselects merge origins separately.",
          "type": "object",
          "properties": {
            "cell": {
              "$ref": "#/$defs/SourceCellAddress"
            },
            "kind": {
              "type": "string",
              "const": "tableCell"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId",
            "cell"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cell": {
              "$ref": "#/$defs/SourceCellAddress"
            },
            "edge": {
              "$ref": "#/$defs/TableCellEdge"
            },
            "kind": {
              "type": "string",
              "const": "tableCellBorder"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId",
            "cell",
            "edge"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tableBackground"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId"
          ]
        },
        {
          "description": "A real table-style declaration instantiated by this native table. None\nselects tblBg. Also identifies the exact lazy phClr reference context.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tableStyleFill"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "region": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TableStyleRegion"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "edge": {
              "$ref": "#/$defs/TableStyleEdge"
            },
            "kind": {
              "type": "string",
              "const": "tableStyleBorder"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "region": {
              "$ref": "#/$defs/TableStyleRegion"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId",
            "region",
            "edge"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rootGroup"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "background"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SourceCellAddress": {
      "type": "object",
      "properties": {
        "column": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "column"
      ]
    },
    "TableCellEdge": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "topLeftToBottomRight",
        "bottomLeftToTopRight"
      ]
    },
    "TableStyleEdge": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "insideHorizontal",
        "insideVertical",
        "topLeftToBottomRight",
        "topRightToBottomLeft"
      ]
    },
    "TableStyleRegion": {
      "type": "string",
      "enum": [
        "wholeTbl",
        "band1H",
        "band2H",
        "band1V",
        "band2V",
        "lastCol",
        "firstCol",
        "lastRow",
        "seCell",
        "swCell",
        "firstRow",
        "neCell",
        "nwCell"
      ]
    }
  }
}
