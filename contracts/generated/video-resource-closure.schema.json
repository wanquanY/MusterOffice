{
  "$id": "urn:musteroffice:runtime:0.1-draft:video-resource-closure",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceClosure",
  "type": "object",
  "properties": {
    "documentDigest": {
      "$ref": "#/$defs/Digest"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceRequirement"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "documentDigest",
    "resources"
  ],
  "$defs": {
    "ByteLength": {
      "description": "Canonical uint64 byte length. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615",
      "x-integer-minimum": "0"
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "ResourceId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ResourceRequirement": {
      "type": "object",
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/ByteLength"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "resourceId": {
          "$ref": "#/$defs/ResourceId"
        }
      },
      "additionalProperties": false,
      "required": [
        "resourceId",
        "digest",
        "byteLength"
      ]
    }
  }
}
