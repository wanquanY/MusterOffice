{
  "$id": "urn:musteroffice:runtime:0.1-draft:operation-job",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobInfo",
  "type": "object",
  "properties": {
    "cancelRequested": {
      "type": "boolean"
    },
    "contractVersion": {
      "$ref": "#/$defs/ContractVersion"
    },
    "createdAt": {
      "$ref": "#/$defs/UnixMillis"
    },
    "documentId": {
      "$ref": "#/$defs/DocumentId"
    },
    "executorDigest": {
      "$ref": "#/$defs/Digest"
    },
    "fence": {
      "$ref": "#/$defs/JobFence"
    },
    "id": {
      "$ref": "#/$defs/RequestId"
    },
    "leaseUntil": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnixMillis"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "type": "string"
    },
    "requestDigest": {
      "$ref": "#/$defs/Digest"
    },
    "requestId": {
      "$ref": "#/$defs/RequestId"
    },
    "result": {
      "description": "Receipts remain durable until explicit host lifecycle management; there is\nno advertised expiry or automatic deletion of committed documents.",
      "anyOf": [
        {
          "$ref": "#/$defs/TerminalResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "updatedAt": {
      "$ref": "#/$defs/UnixMillis"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "id",
    "requestId",
    "operation",
    "documentId",
    "requestDigest",
    "executorDigest",
    "state",
    "cancelRequested",
    "fence",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "AnchorMap": {
      "type": "object",
      "properties": {
        "deleted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inserted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "paragraph": {
          "$ref": "#/$defs/ParagraphId"
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "paragraph",
        "start",
        "deleted",
        "inserted"
      ]
    },
    "AssetRole": {
      "type": "string",
      "enum": [
        "editable-document",
        "pptx",
        "preview",
        "quality-report",
        "image",
        "font",
        "audio",
        "video",
        "model3d",
        "embedded",
        "source",
        "other"
      ]
    },
    "ByteLength": {
      "description": "Canonical uint64 byte length. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615",
      "x-integer-minimum": "0"
    },
    "ChangeSet": {
      "type": "object",
      "properties": {
        "anchorMaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnchorMap"
          }
        },
        "changedFonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FontId"
          }
        },
        "changedLayouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutId"
          }
        },
        "changedMasters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MasterId"
          }
        },
        "changedResources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceId"
          }
        },
        "changedThemes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeId"
          }
        },
        "changedTimelines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "createdObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "createdSlides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "deletedObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "deletedSlides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "invalidateAllLayout": {
          "description": "Conservative until the compiler dependency index can produce a narrower closure.",
          "type": "boolean"
        },
        "metadataChanged": {
          "type": "boolean"
        },
        "slideOrderChanged": {
          "type": "boolean"
        },
        "updatedObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "updatedSlides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "createdObjects",
        "updatedObjects",
        "deletedObjects",
        "createdSlides",
        "updatedSlides",
        "deletedSlides",
        "changedThemes",
        "changedMasters",
        "changedLayouts",
        "changedFonts",
        "changedResources",
        "slideOrderChanged",
        "metadataChanged",
        "invalidateAllLayout",
        "anchorMaps"
      ]
    },
    "Claim": {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/ClaimBasis"
        },
        "evidenceAssetIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequestId"
          }
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "profileId": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "subjectSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "subjectSha256",
        "basis",
        "profileId",
        "evidenceAssetIds"
      ]
    },
    "ClaimBasis": {
      "type": "string",
      "enum": [
        "none",
        "static-inspection",
        "roundtrip",
        "application-test"
      ]
    },
    "ClaimKind": {
      "type": "string",
      "enum": [
        "structure",
        "layout",
        "native-editability",
        "playback",
        "target-application"
      ]
    },
    "ClaimStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_proven",
        "not_applicable"
      ]
    },
    "ContractVersion": {
      "type": "string",
      "enum": [
        "musteroffice.operations/1-draft"
      ]
    },
    "DeliveredDocument": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/DocumentId"
        },
        "modelAssetId": {
          "$ref": "#/$defs/RequestId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "documentId",
        "revision",
        "modelAssetId"
      ]
    },
    "DeliveryAsset": {
      "type": "object",
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/ByteLength"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "mediaType": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AssetRole"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "byteLength",
        "mediaType",
        "role"
      ]
    },
    "DeliveryBundle": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeliveryAsset"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "document": {
          "$ref": "#/$defs/DeliveredDocument"
        },
        "pptxAssetId": {
          "$ref": "#/$defs/RequestId"
        },
        "previews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Preview"
          }
        },
        "profileId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "document",
        "profileId",
        "versions",
        "pptxAssetId",
        "assets",
        "previews",
        "claims"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "DocumentId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ExportReceipt": {
      "type": "object",
      "properties": {
        "bundle": {
          "$ref": "#/$defs/DeliveryBundle"
        },
        "documentId": {
          "$ref": "#/$defs/DocumentId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "semanticDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "documentId",
        "revision",
        "semanticDigest",
        "bundle"
      ]
    },
    "Failure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "detail": true,
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "FailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "NOT_AUTHORIZED",
        "NOT_FOUND",
        "REQUEST_ID_REUSED",
        "REVISION_CONFLICT",
        "REFERENCE_CONFLICT",
        "DOCUMENT_EXISTS",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "EXECUTION_INTERRUPTED",
        "EXECUTOR_MISMATCH",
        "STALE_EXECUTION",
        "STORAGE_FAILURE",
        "RESOURCE_CONFLICT",
        "RESOURCE_EXPIRED",
        "RESOURCE_INCOMPLETE",
        "RESOURCE_BUSY",
        "MAPPING_NOT_IMPLEMENTED",
        "RENDER_FAILURE"
      ]
    },
    "FontId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "JobFence": {
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807"
    },
    "JobState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "LayoutId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "MasterId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "MutationReceipt": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/DocumentId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "semanticDigest": {
          "$ref": "#/$defs/Digest"
        },
        "transaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransactionReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "documentId",
        "revision",
        "semanticDigest"
      ]
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "OperationReceipt": {
      "description": "The mutation wire shape is preserved for existing durable receipts. Both\nalternatives deny unknown fields and have distinct required members.",
      "anyOf": [
        {
          "$ref": "#/$defs/MutationReceipt"
        },
        {
          "$ref": "#/$defs/ExportReceipt"
        }
      ]
    },
    "ParagraphId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Preview": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "imageAssetId": {
          "$ref": "#/$defs/RequestId"
        },
        "pageId": {
          "$ref": "#/$defs/SlideId"
        },
        "sample": {
          "$ref": "#/$defs/PreviewSample"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "pageId",
        "imageAssetId",
        "width",
        "height",
        "sample"
      ]
    },
    "PreviewSample": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "editor"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        }
      ]
    },
    "RequestId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ResourceId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "SlideId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TerminalResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "succeeded"
            },
            "receipt": {
              "$ref": "#/$defs/OperationReceipt"
            }
          },
          "additionalProperties": false,
          "required": [
            "outcome",
            "receipt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/Failure"
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "additionalProperties": false,
          "required": [
            "outcome",
            "error"
          ]
        }
      ]
    },
    "ThemeId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TransactionReceipt": {
      "type": "object",
      "properties": {
        "baseRevision": {
          "$ref": "#/$defs/Digest"
        },
        "changes": {
          "$ref": "#/$defs/ChangeSet"
        },
        "documentId": {
          "$ref": "#/$defs/DocumentId"
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "semanticDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "documentId",
        "requestId",
        "requestDigest",
        "baseRevision",
        "revision",
        "semanticDigest",
        "changes"
      ]
    },
    "UnixMillis": {
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807"
    },
    "Versions": {
      "type": "object",
      "properties": {
        "documentSchema": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "featureRegistrySha256": {
          "$ref": "#/$defs/Digest"
        },
        "fontProfileSha256": {
          "$ref": "#/$defs/Digest"
        },
        "operationSchema": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "engine",
        "documentSchema",
        "operationSchema",
        "rules",
        "featureRegistrySha256",
        "fontProfileSha256"
      ]
    }
  }
}
