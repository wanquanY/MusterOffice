{
  "$id": "urn:musteroffice:runtime:0.1-draft:computation-mutation-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MutationReceipt",
  "type": "object",
  "properties": {
    "documentId": {
      "$ref": "#/$defs/DocumentId"
    },
    "revision": {
      "$ref": "#/$defs/Digest"
    },
    "semanticDigest": {
      "$ref": "#/$defs/Digest"
    },
    "template": {
      "description": "Source and parameter evidence for a new independent document. It is not\na transaction committed against the source, nor the new document's base.",
      "anyOf": [
        {
          "$ref": "#/$defs/InstantiationReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "transaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransactionReceipt"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "documentId",
    "revision",
    "semanticDigest"
  ],
  "$defs": {
    "AnchorMap": {
      "type": "object",
      "properties": {
        "deleted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inserted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "paragraph": {
          "$ref": "#/$defs/ParagraphId"
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "paragraph",
        "start",
        "deleted",
        "inserted"
      ]
    },
    "ChangeSet": {
      "type": "object",
      "properties": {
        "anchorMaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnchorMap"
          }
        },
        "changedFonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FontId"
          }
        },
        "changedLayouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutId"
          }
        },
        "changedMasters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MasterId"
          }
        },
        "changedResources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceId"
          }
        },
        "changedThemes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeId"
          }
        },
        "changedTimelines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "createdObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "createdSlides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "deletedObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "deletedSlides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "invalidateAllLayout": {
          "description": "Global page geometry changed. Otherwise use invalidated_slides; metadata\nand timeline edits have separate change fields and do not dirty layout.",
          "type": "boolean"
        },
        "invalidatedSlides": {
          "description": "Surviving/new pages whose static layout dependency closure changed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        },
        "metadataChanged": {
          "type": "boolean"
        },
        "slideOrderChanged": {
          "type": "boolean"
        },
        "updatedObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          }
        },
        "updatedSlides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlideId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "createdObjects",
        "updatedObjects",
        "deletedObjects",
        "createdSlides",
        "updatedSlides",
        "deletedSlides",
        "changedThemes",
        "changedMasters",
        "changedLayouts",
        "changedFonts",
        "changedResources",
        "slideOrderChanged",
        "metadataChanged",
        "invalidateAllLayout",
        "anchorMaps"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "DocumentId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "DocumentScopeMap": {
      "description": "Total mapping for whole-document instantiation: (source document, local ID)\nbecomes (instance document, same local ID). This preserves every internal\nreference, including opaque native relationships, without an O(n) identity\ntable. It is not a mapping for copying a page into an existing document.",
      "type": "object",
      "properties": {
        "instanceDocument": {
          "$ref": "#/$defs/DocumentId"
        },
        "localIdPolicy": {
          "$ref": "#/$defs/LocalIdPolicy"
        },
        "sourceDocument": {
          "$ref": "#/$defs/DocumentId"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceDocument",
        "instanceDocument",
        "localIdPolicy"
      ]
    },
    "FontId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "InstantiationReceipt": {
      "type": "object",
      "properties": {
        "bindingTransaction": {
          "description": "Pure parameter computation against the immutable source. This is not a\ncommit to the template or the instance. Scope mapping follows binding.",
          "anyOf": [
            {
              "$ref": "#/$defs/TransactionReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateParameterId"
          },
          "uniqueItems": true
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "scopeMap": {
          "$ref": "#/$defs/DocumentScopeMap"
        },
        "semanticDigest": {
          "$ref": "#/$defs/Digest"
        },
        "source": {
          "$ref": "#/$defs/TemplateSource"
        },
        "templateDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "requestDigest",
        "templateDigest",
        "source",
        "scopeMap",
        "boundParameters",
        "revision",
        "semanticDigest"
      ]
    },
    "LayoutId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "LocalIdPolicy": {
      "type": "string",
      "enum": [
        "preserve"
      ]
    },
    "MasterId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ParagraphId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "RequestId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ResourceId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "SlideId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TemplateParameterId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TemplateSource": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/DocumentId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "semanticDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "documentId",
        "revision",
        "semanticDigest"
      ]
    },
    "ThemeId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TransactionReceipt": {
      "type": "object",
      "properties": {
        "baseRevision": {
          "$ref": "#/$defs/Digest"
        },
        "changes": {
          "$ref": "#/$defs/ChangeSet"
        },
        "documentId": {
          "$ref": "#/$defs/DocumentId"
        },
        "requestDigest": {
          "$ref": "#/$defs/Digest"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "semanticDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "documentId",
        "requestId",
        "requestDigest",
        "baseRevision",
        "revision",
        "semanticDigest",
        "changes"
      ]
    }
  }
}
