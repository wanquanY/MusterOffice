{
  "$id": "urn:musteroffice:runtime:0.1-draft:page-compile-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageCompileResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/$defs/PagePlan"
        },
        "status": {
          "type": "string",
          "const": "compiled"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/PageFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "Affine": {
      "description": "Evaluated affine transform, not author rotation/flip/viewport semantics.",
      "type": "object",
      "properties": {
        "linear": {
          "description": "Dimensionless Q32 in row-major order: xx, xy, yx, yy.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedQ32"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "translation": {
          "description": "Q32 in the same coordinate unit as the input point.",
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "linear",
        "translation"
      ]
    },
    "BlendMode": {
      "description": "Porter-Duff composition, separate from the source brush and geometry mask.",
      "type": "string",
      "enum": [
        "sourceOver",
        "source"
      ]
    },
    "Brush": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "solid"
            },
            "rgba": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 4,
              "minItems": 4
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rgba"
          ]
        },
        {
          "type": "object",
          "properties": {
            "gradient": {
              "$ref": "#/$defs/Gradient"
            },
            "kind": {
              "type": "string",
              "const": "gradient"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "gradient"
          ]
        },
        {
          "type": "object",
          "properties": {
            "image": {
              "$ref": "#/$defs/ImageBrush"
            },
            "kind": {
              "type": "string",
              "const": "image"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "image"
          ]
        },
        {
          "description": "Immutable full-viewport pixels before draw `after_draws`, after group\nboundaries at that position. Device-aligned; path/view transforms do not\nmove it. Scope selects a canvas, never an implicit host resource.",
          "type": "object",
          "properties": {
            "afterDraws": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "snapshot"
            },
            "scope": {
              "$ref": "#/$defs/SnapshotScope"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "afterDraws"
          ]
        }
      ]
    },
    "ClipNode": {
      "description": "Evaluated intersection path; geometry has its own transform. Parent clipping\nremains in world coordinates and is never transformed by a child or draw.",
      "type": "object",
      "properties": {
        "parent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "transform": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ContainerId": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/SlideId"
            },
            "kind": {
              "type": "string",
              "const": "slide"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/MasterId"
            },
            "kind": {
              "type": "string",
              "const": "master"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/LayoutId"
            },
            "kind": {
              "type": "string",
              "const": "layout"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ObjectId"
            },
            "kind": {
              "type": "string",
              "const": "group"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "DrawScene": {
      "description": "Evaluated resources/instances, independent of authoring document semantics.",
      "type": "object",
      "properties": {
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClipNode"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathInstance"
          }
        },
        "opacityGroups": {
          "description": "Intervals refer to instances; lowering preserves their order and count.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpacityGroup"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FillPath"
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransformNode"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "paths",
        "transforms",
        "instances"
      ]
    },
    "FillPath": {
      "type": "object",
      "properties": {
        "commands": {
          "description": "Local Q32 EMU; open contours are implicitly closed for filling.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathCommand"
          }
        },
        "fillRule": {
          "$ref": "#/$defs/FillRule"
        }
      },
      "additionalProperties": false,
      "required": [
        "fillRule",
        "commands"
      ]
    },
    "FillRule": {
      "type": "string",
      "enum": [
        "nonzero",
        "evenodd"
      ]
    },
    "FixedQ32": {
      "description": "Signed i128 integer divided by 2^32. Coordinate unit is specified by the owning geometry profile; semantic range validation required.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,38})$",
      "x-integer-maximum": "170141183460469231731687303715884105727",
      "x-integer-minimum": "-170141183460469231731687303715884105728"
    },
    "Gradient": {
      "type": "object",
      "properties": {
        "alpha": {
          "$ref": "#/$defs/GradientAlpha"
        },
        "geometry": {
          "$ref": "#/$defs/GradientGeometry"
        },
        "interpolation": {
          "$ref": "#/$defs/GradientInterpolation"
        },
        "stops": {
          "description": "Nondecreasing positions in [0,1]. Repeated positions are hard stops.\nMissing endpoint positions extend the first/last color to that endpoint.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GradientStop"
          }
        },
        "tile": {
          "$ref": "#/$defs/GradientTile"
        }
      },
      "additionalProperties": false,
      "required": [
        "geometry",
        "stops",
        "tile",
        "interpolation",
        "alpha"
      ]
    },
    "GradientAlpha": {
      "type": "string",
      "enum": [
        "straight",
        "premultiplied"
      ]
    },
    "GradientAxisTile": {
      "type": "string",
      "enum": [
        "clamp",
        "repeat",
        "mirror"
      ]
    },
    "GradientField": {
      "oneOf": [
        {
          "description": "First closed ellipse membership for q=((2u-1)*scaleX,(2v-1)*scaleY).\nAt t=0 the ellipse has innerCenter and innerRadii; at t=1 it is the\nunit circle at the origin. Non-nested families use the first entry.",
          "type": "object",
          "properties": {
            "innerCenter": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "innerRadii": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "kind": {
              "type": "string",
              "const": "elliptic"
            },
            "tileScale": {
              "description": "Each dimensionless scale is in (0,1].",
              "type": "array",
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "uncertainty": {
              "description": "Nonnegative Q32 errors ordered scaleX/Y, centerX/Y, radiusX/Y.\nThey bound geometry parameters, not a uniform scalar/color error.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 6,
              "minItems": 6
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "tileScale",
            "innerCenter",
            "innerRadii"
          ]
        },
        {
          "description": "t = coefficients[0] * u + coefficients[1] * v + coefficients[2].\nu,v are the independently tiled/clamped coordinates in [0,1].",
          "type": "object",
          "properties": {
            "coefficients": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "kind": {
              "type": "string",
              "const": "linear"
            },
            "uncertainty": {
              "description": "Nonnegative dimensionless Q32 errors, before float conversion.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients"
          ]
        },
        {
          "description": "Maximum of four inward edge fields and zero. Rates are ordered left,\ntop, right, bottom; a zero rate disables that edge. Positive rates give\n1-u*left, 1-v*top, 1-(1-u)*right and 1-(1-v)*bottom respectively.",
          "type": "object",
          "properties": {
            "edgeRates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 4,
              "minItems": 4
            },
            "kind": {
              "type": "string",
              "const": "rectangular"
            },
            "uncertainty": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/FixedQ32"
              },
              "maxItems": 4,
              "minItems": 4
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "edgeRates"
          ]
        }
      ]
    },
    "GradientGeometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "end": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "type": "string",
              "const": "linear"
            },
            "start": {
              "$ref": "#/$defs/Point"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "type": "string",
              "const": "radial"
            },
            "radius": {
              "$ref": "#/$defs/FixedQ32"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "center",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "$ref": "#/$defs/GradientField"
            },
            "kind": {
              "type": "string",
              "const": "plane"
            },
            "plane": {
              "$ref": "#/$defs/GradientPlane"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plane",
            "field"
          ]
        }
      ]
    },
    "GradientInterpolation": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "srgb",
            "linearSrgb"
          ]
        },
        {
          "description": "Office's endpoint-pair RGB curve, exponent 15/8; alpha stays linear.\nRequires two endpoint stops or a symmetric three-stop ramp, straight alpha.",
          "type": "string",
          "const": "officeGamma1875"
        }
      ]
    },
    "GradientPlane": {
      "type": "object",
      "properties": {
        "origin": {
          "description": "World Q32 EMU position of the unit tile's top-left corner.",
          "$ref": "#/$defs/Point"
        },
        "tileX": {
          "$ref": "#/$defs/GradientAxisTile"
        },
        "tileY": {
          "$ref": "#/$defs/GradientAxisTile"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/GradientPlaneUncertainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "xStep": {
          "description": "World displacement for a unit change in each tile coordinate.",
          "$ref": "#/$defs/Point"
        },
        "yStep": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "xStep",
        "yStep",
        "tileX",
        "tileY"
      ]
    },
    "GradientPlaneUncertainty": {
      "type": "object",
      "properties": {
        "origin": {
          "description": "Nonnegative Q32 world EMU error per input parameter.",
          "$ref": "#/$defs/Point"
        },
        "xStep": {
          "$ref": "#/$defs/Point"
        },
        "yStep": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "xStep",
        "yStep"
      ]
    },
    "GradientStop": {
      "type": "object",
      "properties": {
        "position": {
          "type": "number",
          "format": "double"
        },
        "srgb": {
          "description": "Straight sRGB working channels. Finite RGB may exceed [0,1]; alpha must\nbe in [0,1]. No RGBA8 quantization is performed before interpolation.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "srgb"
      ]
    },
    "GradientTile": {
      "type": "string",
      "enum": [
        "clamp",
        "repeat",
        "mirror",
        "decal"
      ]
    },
    "ImageBrush": {
      "type": "object",
      "properties": {
        "origin": {
          "description": "World Q32 EMU position of source pixel boundary (0, 0).",
          "$ref": "#/$defs/Point"
        },
        "resource": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sampling": {
          "$ref": "#/$defs/ImageSampling"
        },
        "sourceDomain": {
          "description": "Optional continuous source pixel domain; may extend beyond the resource\ninto transparent space. Coordinates are Q32 pixels, not world EMU.",
          "anyOf": [
            {
              "$ref": "#/$defs/ImageSourceDomain"
            },
            {
              "type": "null"
            }
          ]
        },
        "tileX": {
          "$ref": "#/$defs/ImageTile"
        },
        "tileY": {
          "$ref": "#/$defs/ImageTile"
        },
        "uncertainty": {
          "description": "Outward errors from upstream layout/placement. These participate in the\nsame device budget as float conversion, including repeated tile phase.",
          "anyOf": [
            {
              "$ref": "#/$defs/ImageBrushUncertainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "xStep": {
          "description": "World Q32 EMU displacement per source pixel, not endpoint coordinates.",
          "$ref": "#/$defs/Point"
        },
        "yStep": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "origin",
        "xStep",
        "yStep",
        "tileX",
        "tileY",
        "sampling"
      ]
    },
    "ImageBrushUncertainty": {
      "type": "object",
      "properties": {
        "origin": {
          "description": "Nonnegative Q32 world EMU errors; rebase never changes these bounds.",
          "$ref": "#/$defs/Point"
        },
        "sourceDomain": {
          "description": "Nonnegative Q32 source pixel errors, left/top/right/bottom. Must be zero\nwhen the brush has no explicit source domain.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedQ32"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "xStep": {
          "description": "Nonnegative Q32 world EMU per source pixel.",
          "$ref": "#/$defs/Point"
        },
        "yStep": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "xStep",
        "yStep",
        "sourceDomain"
      ]
    },
    "ImageSampling": {
      "type": "string",
      "enum": [
        "nearest",
        "linear"
      ]
    },
    "ImageSourceDomain": {
      "type": "object",
      "properties": {
        "bottom": {
          "$ref": "#/$defs/FixedQ32"
        },
        "left": {
          "$ref": "#/$defs/FixedQ32"
        },
        "right": {
          "$ref": "#/$defs/FixedQ32"
        },
        "top": {
          "$ref": "#/$defs/FixedQ32"
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "ImageTile": {
      "type": "string",
      "enum": [
        "clamp",
        "repeat",
        "mirror",
        "decal"
      ]
    },
    "LayoutId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "MasterId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "OpacityGroup": {
      "description": "Render the complete interval onto transparent pixels, then source-over it\nonto its parent with a single opacity. This is not per-paint alpha.",
      "type": "object",
      "properties": {
        "endDraw": {
          "description": "Exclusive, and strictly greater than first_draw.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "firstDraw": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "opacity": {
          "description": "0 is transparent; 65535 is opaque. Linear coverage of premultiplied sRGB.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "firstDraw",
        "endDraw",
        "opacity"
      ]
    },
    "PageFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PageFailureCode"
        },
        "feature": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageFeature"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "PageFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "LIMIT_EXCEEDED",
        "COORDINATE_RANGE",
        "PRECISION_EXCEEDED",
        "CANCELLED",
        "MAPPING_NOT_IMPLEMENTED",
        "COMPONENT_FAILURE",
        "COMPONENT_INVALID",
        "HOST_FAILURE"
      ]
    },
    "PageFeature": {
      "type": "string",
      "enum": [
        "table",
        "shapeText",
        "picture",
        "connector",
        "inheritedFill",
        "inheritedStroke",
        "unresolvedStrokeParameters",
        "groupStroke",
        "missingThemeColor"
      ]
    },
    "PagePaintKind": {
      "type": "string",
      "enum": [
        "fill",
        "stroke"
      ]
    },
    "PagePaintSource": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/ContainerId"
        },
        "instance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "object": {
          "description": "None denotes the page background. Groups create spaces, not paint draws.",
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "paint": {
          "$ref": "#/$defs/PagePaintKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "container",
        "instance",
        "paint"
      ]
    },
    "PagePlan": {
