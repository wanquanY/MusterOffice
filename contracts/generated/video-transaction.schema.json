              "$ref": "#/$defs/ResourceId"
            },
            "stream": {
              "$ref": "#/$defs/ObjectId"
            },
            "timeMap": {
              "$ref": "#/$defs/TimeMap"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "resource",
            "stream",
            "timeMap"
