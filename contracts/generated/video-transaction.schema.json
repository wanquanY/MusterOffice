    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Edge": {
      "type": "string",
      "enum": [
        "start",
        "end"
      ]
