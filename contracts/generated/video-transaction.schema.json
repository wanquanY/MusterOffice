              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectId"
              }
            },
            "delta": {
              "$ref": "#/$defs/RationalTime"
            },
            "edge": {
              "$ref": "#/$defs/Edge"
            },
            "linkedPolicy": {
              "$ref": "#/$defs/LinkedPolicy"
            },
