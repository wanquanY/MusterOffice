    },
    "ResourceId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
