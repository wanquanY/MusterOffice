{
  "$id": "urn:musteroffice:runtime:0.1-draft:video-transaction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transaction",
  "type": "object",
  "properties": {
    "contract": {
      "$ref": "#/$defs/EditContract"
