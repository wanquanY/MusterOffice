    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/FixedQ32"
        },
        "y": {
          "$ref": "#/$defs/FixedQ32"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "PptxFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PptxFailureCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "PptxFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "SOURCE_CONFLICT",
        "PRESERVATION_CONFLICT",
        "MAPPING_NOT_IMPLEMENTED",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "READ_FAILED"
      ]
    },
    "Size": {
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/Emu"
        },
        "width": {
          "$ref": "#/$defs/Emu"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
