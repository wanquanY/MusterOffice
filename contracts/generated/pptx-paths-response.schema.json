    "SourceNativePaths": {
      "type": "object",
      "properties": {
        "coordinateTolerance": {
          "$ref": "#/$defs/FixedQ32"
        },
        "geometryProfile": {
          "$ref": "#/$defs/GeometryProfile"
        },
        "objects": {
          "type": "array",
