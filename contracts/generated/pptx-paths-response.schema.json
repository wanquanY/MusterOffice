    "SourceObjectRef": {
      "type": "object",
      "properties": {
        "nativeId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "part": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "part",
        "nativeId"
      ]
    },
    "SourceResolvedValue": {
      "type": "object",
      "properties": {
        "declaredBy": {
          "description": "Ultimate explicit declaration, not merely the next inheritance hop.",
          "$ref": "#/$defs/SourceObjectRef"
        },
        "value": {
          "$ref": "#/$defs/Size"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "declaredBy"
      ]
