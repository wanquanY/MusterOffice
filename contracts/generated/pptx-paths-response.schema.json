{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-paths-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PptxPathsResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "paths": {
          "$ref": "#/$defs/SourceNativePaths"
        },
        "status": {
          "type": "string",
          "const": "compiled"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "paths"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/PptxFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "CompiledNativePath": {
      "type": "object",
      "properties": {
        "arcSegments": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathCommand"
          }
        },
        "coordinateErrorBound": {
          "$ref": "#/$defs/Point"
        },
        "curveErrorBound": {
          "$ref": "#/$defs/Point"
        },
        "extrusionOk": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fill": {
          "description": "Source paint modifiers are preserved; paint resolution owns defaults.",
          "anyOf": [
            {
              "$ref": "#/$defs/NativePathFill"
            },
            {
              "type": "null"
            }
          ]
        },
        "numericErrorBound": {
          "$ref": "#/$defs/Point"
        },
        "origin": {
          "$ref": "#/$defs/GeometryOrigin"
        },
        "sourceMap": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativePathSpan"
          }
        },
        "stroke": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "commands",
        "sourceMap",
        "numericErrorBound",
        "curveErrorBound",
        "coordinateErrorBound",
        "arcSegments"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Emu": {
      "description": "Signed int64 EMU. 1 point = 12700 EMU. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "FixedQ32": {
      "description": "Signed i128 integer divided by 2^32. Coordinate unit is specified by the owning geometry profile; semantic range validation required.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,38})$",
      "x-integer-maximum": "170141183460469231731687303715884105727",
      "x-integer-minimum": "-170141183460469231731687303715884105728"
    },
    "FormulaIssue": {
      "type": "string",
      "enum": [
        "unknownOperation",
        "arity",
        "divisionByZero",
        "undefinedDirection",
        "tangentPole"
      ]
    },
    "GeometryOrigin": {
      "description": "Ordinals are zero-based element preorder in the indicated XML resource.\nPreset ordinals address the pinned, generated catalog definition, not the\ndocument part. A document override always retains its physical source.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "document"
            },
            "sourceOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sourceOrdinal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "definitionOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "preset"
            },
            "preset": {
              "$ref": "#/$defs/NativeShapeType"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "preset",
            "definitionOrdinal"
          ]
        }
      ]
    },
    "GeometryProfile": {
      "type": "string",
      "enum": [
        "ecma376-2016-ms-presets-draft-v2"
      ]
    },
    "GeometryUnresolved": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missingDeclaration"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unsupportedObject"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missingExtent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalidExtent"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "retainedContent"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "issue": {
              "$ref": "#/$defs/FormulaIssue"
            },
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "issue"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalidCoordinate"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalidAngle"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknownReference"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "token": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "reservedGuide"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalidGuideName"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalidHandleReference"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "numericRange"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        }
      ]
    },
    "NativeObjectPaths": {
      "type": "object",
      "properties": {
        "nativeId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/NativeObjectPathsOutcome"
        }
      },
      "additionalProperties": false,
      "required": [
        "nativeId",
        "outcome"
      ]
    },
    "NativeObjectPathsOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "extent": {
              "$ref": "#/$defs/SourceResolvedValue"
            },
            "paths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CompiledNativePath"
              }
            },
            "status": {
              "type": "string",
              "const": "compiled"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "extent",
            "paths"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/GeometryUnresolved"
            },
            "status": {
              "type": "string",
              "const": "unresolvedGeometry"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "issue": {
              "$ref": "#/$defs/NativePathIssue"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "status": {
              "type": "string",
              "const": "unresolvedPath"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "origin",
            "issue"
          ]
        }
      ]
    },
    "NativePathFill": {
      "type": "string",
      "enum": [
        "none",
        "norm",
        "lighten",
        "lightenLess",
        "darken",
        "darkenLess"
      ]
    },
    "NativePathIssue": {
      "type": "string",
      "enum": [
        "invalidExtent",
        "zeroPathExtent",
        "negativeRadius",
        "degenerateArcRadius",
        "numericRange",
        "precisionExceeded"
      ]
    },
    "NativePathProfile": {
      "type": "string",
      "enum": [
        "drawingml-polar-arcs-q96-hermite-v1-draft"
      ]
    },
    "NativePathSpan": {
      "type": "object",
      "properties": {
        "commandCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "firstCommand": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "origin": {
          "$ref": "#/$defs/GeometryOrigin"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "firstCommand",
        "commandCount"
      ]
    },
