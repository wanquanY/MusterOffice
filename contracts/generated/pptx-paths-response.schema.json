    "PathCommand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "line"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "type": "string",
              "const": "quadratic"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control1": {
              "$ref": "#/$defs/Point"
            },
            "control2": {
              "$ref": "#/$defs/Point"
            },
            "kind": {
              "type": "string",
              "const": "cubic"
            },
            "to": {
              "$ref": "#/$defs/Point"
            }
          },
          "additionalProperties": false,
