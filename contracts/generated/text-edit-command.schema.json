{
  "$id": "urn:musteroffice:runtime:0.1-draft:text-edit-command",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextEditCommand",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/TextEditAction"
    },
    "baseRevision": {
      "$ref": "#/$defs/Digest"
    },
    "cell": {
      "description": "Required for an authored table cell; absent for shape text. Never a\nphysical row/column ordinal. Omission preserves existing command hashes.",
      "anyOf": [
        {
          "$ref": "#/$defs/CellId"
        },
        {
          "type": "null"
        }
      ]
    },
    "documentId": {
      "$ref": "#/$defs/DocumentId"
    },
    "object": {
      "$ref": "#/$defs/ObjectId"
    },
    "operationId": {
      "$ref": "#/$defs/OperationId"
    },
    "requestId": {
      "$ref": "#/$defs/RequestId"
    }
  },
  "additionalProperties": false,
  "required": [
    "documentId",
    "requestId",
    "baseRevision",
    "operationId",
    "object",
    "action"
  ],
  "$defs": {
    "Affinity": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ]
    },
    "Alignment": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end",
        "justify"
      ]
    },
    "CellId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "CharacterStyle": {
      "type": "object",
      "properties": {
        "bold": {
          "$ref": "#/$defs/Inherited4",
          "default": {
            "kind": "inherit"
          }
        },
        "color": {
          "$ref": "#/$defs/Inherited3",
          "default": {
            "kind": "inherit"
          }
        },
        "font": {
          "$ref": "#/$defs/Inherited",
          "default": {
            "kind": "inherit"
          }
        },
        "italic": {
          "$ref": "#/$defs/Inherited4",
          "default": {
            "kind": "inherit"
          }
        },
        "language": {
          "$ref": "#/$defs/Inherited5",
          "default": {
            "kind": "inherit"
          }
        },
        "size": {
          "$ref": "#/$defs/Inherited2",
          "default": {
            "kind": "inherit"
          }
        },
        "underline": {
          "$ref": "#/$defs/Inherited4",
          "default": {
            "kind": "inherit"
          }
        }
      },
      "additionalProperties": false
    },
    "CharacterStylePatch": {
      "description": "Omitted fields keep their declarations; `inherit` explicitly resets one\nfield. Applying bold must not resolve or overwrite font/theme inheritance.",
      "type": "object",
      "properties": {
        "bold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited4"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited3"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited"
            },
            {
              "type": "null"
            }
          ]
        },
        "italic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited4"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited5"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited2"
            },
            {
              "type": "null"
            }
          ]
        },
        "underline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Color": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "srgb"
            },
            "rgba": {
              "$ref": "#/$defs/Rgba"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rgba"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "theme"
            },
            "slot": {
              "$ref": "#/$defs/ThemeColor"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "slot"
          ]
        }
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "DocumentId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Emu": {
      "description": "Signed int64 EMU. 1 point = 12700 EMU. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "FontId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Inherited": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/FontId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/Emu"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/Color"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited5": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited6": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/Alignment"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited7": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/TextDirection"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Insets": {
      "type": "object",
      "properties": {
        "bottom": {
          "$ref": "#/$defs/Emu"
        },
        "left": {
          "$ref": "#/$defs/Emu"
        },
        "right": {
          "$ref": "#/$defs/Emu"
        },
        "top": {
          "$ref": "#/$defs/Emu"
        }
      },
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "OperationId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "OverflowPolicy": {
      "type": "string",
      "enum": [
        "report",
        "clip",
        "growShape"
      ]
    },
    "ParagraphId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ParagraphLineSpacing": {
      "description": "Native paragraph line spacing. Percentage is measured against the line's\nlargest font size by the shared layout engine; 100000 means 100%, 150000 150%.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "percent"
            },
            "value": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Exact baseline spacing in EMU; must be representable in 1/100 point.",
          "type": "object",
          "properties": {
            "height": {
              "$ref": "#/$defs/Emu"
            },
            "kind": {
              "type": "string",
              "const": "exact"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "height"
          ]
        }
      ]
    },
    "ParagraphStyle": {
      "type": "object",
      "properties": {
        "alignment": {
          "$ref": "#/$defs/Inherited6",
          "default": {
            "kind": "inherit"
          }
        },
        "direction": {
          "$ref": "#/$defs/Inherited7",
          "default": {
            "kind": "inherit"
          }
        },
        "indent": {
          "description": "Relative to the paragraph margin; negative values create a hanging indent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Emu"
            },
            {
              "type": "null"
            }
          ]
        },
        "leftMargin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Emu"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineSpacing": {
          "description": "Omitted values retain native inheritance and historical document digests.",
          "anyOf": [
            {
              "$ref": "#/$defs/ParagraphLineSpacing"
            },
            {
              "type": "null"
            }
          ]
        },
        "rightMargin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Emu"
            },
            {
              "type": "null"
            }
          ]
        },
        "spaceAfter": {
          "$ref": "#/$defs/Inherited2",
          "default": {
            "kind": "inherit"
          }
        },
        "spaceBefore": {
          "$ref": "#/$defs/Inherited2",
          "default": {
            "kind": "inherit"
          }
        }
      },
      "additionalProperties": false
    },
    "RequestId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Rgba": {
      "type": "object",
      "properties": {
        "alpha": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "blue": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "green": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "red": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "red",
        "green",
        "blue",
        "alpha"
      ]
    },
    "TextAnchor": {
      "type": "object",
      "properties": {
        "affinity": {
          "$ref": "#/$defs/Affinity"
        },
        "paragraph": {
          "$ref": "#/$defs/ParagraphId"
        },
        "scalarOffset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "paragraph",
        "scalarOffset",
        "affinity"
      ]
    },
    "TextBodySetup": {
      "type": "object",
      "properties": {
        "defaultRunStyle": {
          "$ref": "#/$defs/CharacterStyle"
        },
        "insets": {
          "$ref": "#/$defs/Insets"
        },
        "overflow": {
          "$ref": "#/$defs/OverflowPolicy"
        },
        "paragraphStyle": {
          "$ref": "#/$defs/ParagraphStyle"
        },
        "style": {
          "$ref": "#/$defs/CharacterStyle"
        },
        "wrap": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "style",
        "insets",
        "wrap",
        "overflow",
        "paragraphStyle",
        "defaultRunStyle"
      ]
    },
    "TextDirection": {
      "type": "string",
      "enum": [
        "leftToRight",
        "rightToLeft",
        "verticalRightToLeft",
        "verticalLeftToRight"
      ]
    },
    "TextEditAction": {
      "oneOf": [
        {
          "description": "Create a missing authored text body. The kernel assigns all paragraph\nand run identities; the host supplies explicit layout/style defaults.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "initialize"
            },
            "setup": {
              "$ref": "#/$defs/TextBodySetup"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text",
            "setup"
          ]
        },
        {
          "description": "CRLF and CR become paragraph breaks; tabs become typed inline tabs.\nSurviving runs keep their style;\ninserted text inherits the declaration at the start caret's affinity.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "replace"
            },
            "selection": {
              "$ref": "#/$defs/TextSelection"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selection",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "setCharacterStyle"
            },
            "patch": {
              "$ref": "#/$defs/CharacterStylePatch"
            },
            "selection": {
              "$ref": "#/$defs/TextSelection"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selection",
            "patch"
          ]
        }
      ]
    },
    "TextSelection": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/TextAnchor"
        },
        "focus": {
          "$ref": "#/$defs/TextAnchor"
        }
      },
      "additionalProperties": false,
      "required": [
        "anchor",
        "focus"
      ]
    },
    "ThemeColor": {
      "type": "string",
      "enum": [
        "dark1",
        "light1",
        "dark2",
        "light2",
        "accent1",
        "accent2",
        "accent3",
        "accent4",
        "accent5",
        "accent6",
        "hyperlink",
        "followedHyperlink"
      ]
    }
  }
}
