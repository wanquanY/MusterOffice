{
  "$id": "urn:musteroffice:runtime:0.1-draft:text-edit-command",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextEditCommand",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/TextEditAction"
    },
    "baseRevision": {
      "$ref": "#/$defs/Digest"
    },
    "documentId": {
      "$ref": "#/$defs/DocumentId"
    },
    "object": {
      "$ref": "#/$defs/ObjectId"
    },
    "operationId": {
      "$ref": "#/$defs/OperationId"
    },
    "requestId": {
      "$ref": "#/$defs/RequestId"
    }
  },
  "additionalProperties": false,
  "required": [
    "documentId",
    "requestId",
    "baseRevision",
    "operationId",
    "object",
    "action"
  ],
  "$defs": {
    "Affinity": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ]
    },
    "CharacterStylePatch": {
      "description": "Omitted fields keep their declarations; `inherit` explicitly resets one\nfield. Applying bold must not resolve or overwrite font/theme inheritance.",
      "type": "object",
      "properties": {
        "bold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited4"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited3"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited"
            },
            {
              "type": "null"
            }
          ]
        },
        "italic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited4"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited5"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited2"
            },
            {
              "type": "null"
            }
          ]
        },
        "underline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inherited4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Color": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "srgb"
            },
            "rgba": {
              "$ref": "#/$defs/Rgba"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rgba"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "theme"
            },
            "slot": {
              "$ref": "#/$defs/ThemeColor"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "slot"
          ]
        }
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "DocumentId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Emu": {
      "description": "Signed int64 EMU. 1 point = 12700 EMU. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "FontId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Inherited": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/FontId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/Emu"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/Color"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "Inherited5": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inherit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "OperationId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ParagraphId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "RequestId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Rgba": {
      "type": "object",
      "properties": {
        "alpha": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "blue": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "green": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "red": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "red",
        "green",
        "blue",
        "alpha"
      ]
    },
    "TextAnchor": {
      "type": "object",
      "properties": {
        "affinity": {
          "$ref": "#/$defs/Affinity"
        },
        "paragraph": {
          "$ref": "#/$defs/ParagraphId"
        },
        "scalarOffset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "paragraph",
        "scalarOffset",
        "affinity"
      ]
    },
    "TextEditAction": {
      "oneOf": [
        {
          "description": "CRLF and CR become paragraph breaks. Surviving runs keep their style;\ninserted text inherits the declaration at the start caret's affinity.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "replace"
            },
            "selection": {
              "$ref": "#/$defs/TextSelection"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selection",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "setCharacterStyle"
            },
            "patch": {
              "$ref": "#/$defs/CharacterStylePatch"
            },
            "selection": {
              "$ref": "#/$defs/TextSelection"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "selection",
            "patch"
          ]
        }
      ]
    },
    "TextSelection": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/TextAnchor"
        },
        "focus": {
          "$ref": "#/$defs/TextAnchor"
        }
      },
      "additionalProperties": false,
      "required": [
        "anchor",
        "focus"
      ]
    },
    "ThemeColor": {
      "type": "string",
      "enum": [
        "dark1",
        "light1",
        "dark2",
        "light2",
        "accent1",
        "accent2",
        "accent3",
        "accent4",
        "accent5",
        "accent6",
        "hyperlink",
        "followedHyperlink"
      ]
    }
  }
}
