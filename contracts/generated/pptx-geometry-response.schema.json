{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-geometry-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PptxGeometryResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/SourceGeometryValues"
        },
        "status": {
          "type": "string",
          "const": "evaluated"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "geometry"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/PptxFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Emu": {
      "description": "Signed int64 EMU. 1 point = 12700 EMU. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "EvaluatedCommand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "to": {
              "$ref": "#/$defs/EvaluatedPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "line"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "to": {
              "$ref": "#/$defs/EvaluatedPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "heightRadius": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "arc"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "startAngle": {
              "type": "number",
              "format": "double"
            },
            "sweepAngle": {
              "type": "number",
              "format": "double"
            },
            "widthRadius": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "widthRadius",
            "heightRadius",
            "startAngle",
            "sweepAngle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/EvaluatedPoint"
            },
            "kind": {
              "type": "string",
              "const": "quadratic"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "to": {
              "$ref": "#/$defs/EvaluatedPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "control",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control1": {
              "$ref": "#/$defs/EvaluatedPoint"
            },
            "control2": {
              "$ref": "#/$defs/EvaluatedPoint"
            },
            "kind": {
              "type": "string",
              "const": "cubic"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "to": {
              "$ref": "#/$defs/EvaluatedPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "control1",
            "control2",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "close"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ]
        }
      ]
    },
    "EvaluatedConnection": {
      "type": "object",
      "properties": {
        "angle": {
          "type": "number",
          "format": "double"
        },
        "origin": {
          "$ref": "#/$defs/GeometryOrigin"
        },
        "position": {
          "$ref": "#/$defs/EvaluatedPoint"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "angle",
        "position"
      ]
    },
    "EvaluatedGeometry": {
      "type": "object",
      "properties": {
        "adjustments": {
          "description": "Source order is preserved. Repeated names bind to the last prior value.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideValue"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatedConnection"
          }
        },
        "extent": {
          "$ref": "#/$defs/SourceResolvedValue"
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuideValue"
          }
        },
        "handles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatedHandle"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatedPath"
          }
        },
        "sourceOrdinal": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "textRect": {
          "description": "Absence is not replaced with an invented native text rectangle.",
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluatedRect"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceOrdinal",
        "extent",
        "adjustments",
        "guides",
        "handles",
        "connections",
        "paths"
      ]
    },
    "EvaluatedHandle": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "guideX": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GeometryOrigin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "guideY": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GeometryOrigin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "xy"
            },
            "maxX": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "maxY": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "minX": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "minY": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "position": {
              "$ref": "#/$defs/EvaluatedPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "position"
          ]
        },
        {
          "type": "object",
          "properties": {
            "guideAngle": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GeometryOrigin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "guideRadius": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GeometryOrigin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "polar"
            },
            "maxAngle": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "maxRadius": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "minAngle": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "minRadius": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "origin": {
              "$ref": "#/$defs/GeometryOrigin"
            },
            "position": {
              "$ref": "#/$defs/EvaluatedPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "position"
          ]
        }
      ]
    },
    "EvaluatedPath": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatedCommand"
          }
        },
        "extrusionOk": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativePathFill"
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/$defs/Emu"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/GeometryOrigin"
        },
        "stroke": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "width": {
          "description": "Native path-space extents. Scaling into shape space is a later step.",
          "anyOf": [
            {
              "$ref": "#/$defs/Emu"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "commands"
      ]
    },
    "EvaluatedPoint": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/GeometryOrigin"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "x",
        "y"
      ]
    },
    "EvaluatedRect": {
      "type": "object",
      "properties": {
        "bottom": {
          "type": "number",
          "format": "double"
        },
        "left": {
          "type": "number",
          "format": "double"
        },
        "origin": {
          "$ref": "#/$defs/GeometryOrigin"
        },
        "right": {
          "type": "number",
          "format": "double"
        },
        "top": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "FormulaIssue": {
      "type": "string",
      "enum": [
        "unknownOperation",
        "arity",
        "divisionByZero",
        "undefinedDirection",
        "tangentPole"
      ]
    },
    "GeometryOrigin": {
      "description": "Ordinals are zero-based element preorder in the indicated XML resource.\nPreset ordinals address the pinned, generated catalog definition, not the\ndocument part. A document override always retains its physical source.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "document"
            },
            "sourceOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sourceOrdinal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "definitionOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "preset"
            },
            "preset": {
              "$ref": "#/$defs/NativeShapeType"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "preset",
            "definitionOrdinal"
          ]
        }
      ]
    },
    "GeometryOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/EvaluatedGeometry"
            },
            "status": {
              "type": "string",
              "const": "resolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "geometry"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/GeometryUnresolved"
            },
            "status": {
              "type": "string",
              "const": "unresolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "GeometryProfile": {
      "type": "string",
      "enum": [
        "ecma376-2016-ms-presets-draft-v2"
      ]
    },
    "GeometryResult": {
      "type": "object",
      "properties": {
        "nativeId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/GeometryOutcome"
        }
      },
      "additionalProperties": false,
      "required": [
        "nativeId",
        "outcome"
      ]
    },
    "GeometryUnresolved": {
      "oneOf": [
        {
          "type": "object",
