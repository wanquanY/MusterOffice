{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-table-border-query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceTableBorderQuery",
  "type": "object",
  "properties": {
    "colorProfile": {
      "$ref": "#/$defs/ColorProfile"
    },
    "context": {
      "$ref": "#/$defs/ColorContext"
    },
    "expectedSourceSha256": {
      "$ref": "#/$defs/Digest"
    },
    "fillProfile": {
      "$ref": "#/$defs/FillProfile"
    },
    "lineProfile": {
      "$ref": "#/$defs/LineProfile"
    },
    "surface": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableBorderTarget"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "expectedSourceSha256",
    "surface",
    "targets",
    "lineProfile",
    "fillProfile",
    "colorProfile",
    "context"
  ],
  "$defs": {
    "ColorContext": {
      "type": "object",
      "properties": {
        "placeholder": {
          "description": "Explicit unassociated sRGB and alpha, supplied by the owning style.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "systemColors": {
          "type": "object",
          "properties": {
            "3dDkShadow": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "3dLight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "activeBorder": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "activeCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "appWorkspace": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "background": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnFace": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnHighlight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnShadow": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "captionText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "gradientActiveCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "gradientInactiveCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "grayText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "highlight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "highlightText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "hotLight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "inactiveBorder": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "inactiveCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "inactiveCaptionText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "infoBk": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "infoText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "menu": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "menuBar": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "menuHighlight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "menuText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "scrollBar": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "window": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "windowFrame": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "windowText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "systemColors"
      ]
    },
    "ColorProfile": {
      "description": "A named, provisional numerical interpretation, not an Office/WPS certificate.",
      "type": "string",
      "enum": [
        "ecma376-2016-draft-v1"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "FillProfile": {
      "description": "An explicit interpretation, not a certificate for any Office/WPS version.",
      "type": "string",
      "enum": [
        "ms-oi29500-fills-2024-draft-v1"
      ]
    },
    "LineProfile": {
      "description": "Explicit interpretation of the documented multi-pass DrawingML rules.\nThis is not a certificate for a particular Office/WPS version or renderer.",
      "type": "string",
      "enum": [
        "ms-oi29500-lines-2024-draft-v1"
      ]
    },
    "SourceCellAddress": {
      "type": "object",
      "properties": {
        "column": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "column"
      ]
    },
    "TableBorderTarget": {
      "type": "object",
      "properties": {
        "cell": {
          "$ref": "#/$defs/SourceCellAddress"
        },
        "edge": {
          "$ref": "#/$defs/TableCellEdge"
        },
        "nativeId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "nativeId",
        "cell",
        "edge"
      ]
    },
    "TableCellEdge": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "topLeftToBottomRight",
        "bottomLeftToTopRight"
      ]
    }
  }
}
