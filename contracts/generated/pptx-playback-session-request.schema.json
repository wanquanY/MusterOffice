{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-playback-session-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PptxPlaybackSessionRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "prepare"
        },
        "request": {
          "$ref": "#/$defs/PptxPlaybackPrepareRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "operation": {
          "type": "string",
          "const": "inspect"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "binding"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "operation": {
          "type": "string",
          "const": "inspectTiming"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "binding"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "render"
        },
        "sample": {
          "$ref": "#/$defs/PlaybackSampleRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "sample"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "expectedViewportRevision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "const": "resize"
        },
        "viewport": {
          "$ref": "#/$defs/RasterViewport"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "binding",
        "expectedViewportRevision",
        "viewport"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "expectedViewportRevision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "const": "resizeToFit"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "binding",
        "expectedViewportRevision",
        "width",
        "height"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "generation": {
          "$ref": "#/$defs/PlaybackGeneration"
        },
        "operation": {
          "type": "string",
          "const": "advance"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "binding",
        "generation"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "operation": {
          "type": "string",
          "const": "dispose"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "binding"
      ]
    }
  ],
  "$defs": {
    "ByteLength": {
      "description": "Canonical uint64 byte length. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615",
      "x-integer-minimum": "0"
    },
    "CascadeFont": {
      "description": "Explicit resource bundle bindings, not system font names or legal permissions.",
      "type": "object",
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/ByteLength"
        },
        "expectedSha256": {
          "$ref": "#/$defs/Digest"
        },
        "faceIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "$ref": "#/$defs/ByteLength"
        }
      },
      "additionalProperties": false,
      "required": [
        "expectedSha256",
        "faceIndex",
        "offset",
        "byteLength"
      ]
    },
    "ColorContext": {
      "type": "object",
      "properties": {
        "placeholder": {
          "description": "Explicit unassociated sRGB and alpha, supplied by the owning style.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "systemColors": {
          "type": "object",
          "properties": {
            "3dDkShadow": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "3dLight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "activeBorder": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "activeCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "appWorkspace": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "background": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnFace": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnHighlight": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnShadow": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "btnText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "captionText": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "gradientActiveCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "gradientInactiveCaption": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            },
            "grayText": {
              "type": "array",
              "items": {
