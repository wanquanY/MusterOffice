              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "systemColors"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "EventHistory": {
      "description": "Complete prefix, explicitly including periods when no event occurred. A host\nthat cannot supply this context must not invent clicks when seeking.",
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaybackEvent"
          }
        },
        "through": {
          "$ref": "#/$defs/RationalTime"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "through",
        "events"
      ]
    },
    "FixedQ32": {
      "description": "Signed i128 integer divided by 2^32. Coordinate unit is specified by the owning geometry profile; semantic range validation required.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,38})$",
      "x-integer-maximum": "170141183460469231731687303715884105727",
      "x-integer-minimum": "-170141183460469231731687303715884105728"
    },
    "FontManifest": {
      "type": "object",
      "properties": {
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestFace"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CascadeFont"
          }
        },
        "profile": {
          "$ref": "#/$defs/FontManifestProfile"
        },
        "typefaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestTypeface"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "fonts",
        "faces",
        "typefaces"
      ]
    },
    "FontManifestProfile": {
      "type": "string",
      "enum": [
        "explicit-font-resource-manifest-draft-v1"
      ]
    },
    "FontNameBinding": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "string"
        },
        "record": {
          "description": "Exact index in VerifiedFont metadata.names, preserving original record order.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "record",
        "expected"
      ]
    },
    "ImageSampling": {
      "type": "string",
      "enum": [
        "nearest",
        "linear"
      ]
    },
    "ImageSourceSelection": {
      "description": "Explicit source policy. An embedded snapshot is never silently substituted\nfor a requested linked source, nor does inspection grant network authority.",
      "type": "string",
      "enum": [
        "embeddedSnapshot",
        "linkedSource"
      ]
    },
    "InputEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "click"
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ObjectId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "direction": {
              "$ref": "#/$defs/NavigationDirection"
            },
            "kind": {
              "type": "string",
              "const": "navigation"
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ObjectId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "direction"
          ]
        }
      ]
    },
    "ManifestFace": {
      "type": "object",
      "properties": {
        "family": {
          "$ref": "#/$defs/FontNameBinding"
        },
        "font": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "postscript": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontNameBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "subfamily": {
          "$ref": "#/$defs/FontNameBinding"
        }
      },
      "additionalProperties": false,
      "required": [
        "font",
        "family",
        "subfamily"
      ]
    },
    "ManifestInstance": {
      "type": "object",
      "properties": {
        "face": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "variations": {
          "description": "All axes are validated, including instances unused by this paragraph.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapeVariation"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "face",
        "variations"
      ]
    },
    "ManifestTypeface": {
      "type": "object",
      "properties": {
        "bold": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManifestInstance"
            },
            {
              "type": "null"
            }
          ]
        },
        "boldItalic": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManifestInstance"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallbacks": {
          "description": "Ordered, explicit coverage fallbacks into this manifest's typefaces.\nOnly these entries are tried; their own fallbacks are not expanded.\nEach candidate uses the requested style slot without synthesis.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "italic": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManifestInstance"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/TypefaceMappingPolicy"
        },
        "regular": {
          "description": "Explicit instance selection; no synthesized bold/slant or slot fallback.",
          "anyOf": [
            {
              "$ref": "#/$defs/ManifestInstance"
            },
            {
              "type": "null"
            }
          ]
        },
        "typeface": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "typeface",
        "policy"
      ]
    },
    "NavigationDirection": {
      "type": "string",
      "enum": [
        "next",
        "previous"
      ]
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "PixelScale": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "numerator": {
          "description": "Positive rational pixels per EMU; normalized internally.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "PlaybackBinding": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/$defs/PlaybackGeneration"
        },
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "session": {
          "$ref": "#/$defs/PlaybackSessionId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session",
        "revision",
        "generation"
      ]
    },
    "PlaybackEvent": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/RationalTime"
        },
        "event": {
          "$ref": "#/$defs/InputEvent"
        },
        "generation": {
          "$ref": "#/$defs/PlaybackGeneration"
        },
        "sequence": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "generation",
        "sequence",
        "at",
        "event"
      ]
    },
    "PlaybackGeneration": {
      "description": "Canonical uint64 playback generation; never wraps.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615"
    },
    "PlaybackSampleRequest": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/RationalTime"
        },
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventHistory"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "at"
      ]
    },
    "PlaybackSessionId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/FixedQ32"
        },
        "y": {
          "$ref": "#/$defs/FixedQ32"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "PptxPlaybackPrepareRequest": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/PlaybackBinding"
        },
        "page": {
          "$ref": "#/$defs/PptxResourcePageRequest"
        }
      },
      "additionalProperties": false,
      "required": [
        "page",
        "binding"
      ]
    },
    "PptxResourcePageProfile": {
      "type": "string",
      "enum": [
        "drawingml-resource-page-q32-v1-draft"
      ]
    },
    "PptxResourcePageRequest": {
      "type": "object",
      "properties": {
        "fonts": {
          "description": "None disables source text; a visible text body then requires resources.\nFonts are explicit names/content ranges, never OS discovery or paths.",
          "anyOf": [
            {
              "$ref": "#/$defs/FontManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "imageSource": {
          "$ref": "#/$defs/ImageSourceSelection"
        },
        "page": {
          "$ref": "#/$defs/SourcePageRequest"
        },
        "profile": {
          "$ref": "#/$defs/PptxResourcePageProfile"
        },
        "sampling": {
          "$ref": "#/$defs/ImageSampling"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "page",
        "imageSource",
        "sampling"
      ]
    },
    "RasterViewport": {
      "type": "object",
      "properties": {
        "background": {
          "description": "Straight sRGB RGBA8; output is premultiplied.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 4,
          "minItems": 4
        },
        "coordinateTolerance": {
          "description": "Raw Q32 pixels; 256..=2^24 (at most 1/256 pixel).",
          "$ref": "#/$defs/FixedQ32"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "origin": {
          "description": "Q32 EMU. Subtracted before converting to device-space float32.",
          "$ref": "#/$defs/Point"
        },
        "scale": {
          "$ref": "#/$defs/PixelScale"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "origin",
        "scale",
        "coordinateTolerance",
        "background"
      ]
    },
    "RationalTime": {
      "description": "Exact wire representation. Equality compares author values; compare_time compares instants.",
      "type": "object",
      "properties": {
        "ticks": {
          "$ref": "#/$defs/Ticks"
        },
        "timescale": {
          "$ref": "#/$defs/Timescale"
        }
      },
      "additionalProperties": false,
      "required": [
        "ticks",
        "timescale"
      ]
    },
    "ShapeVariation": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "value1616": {
          "description": "Exact requested OpenType 16.16 design coordinate.",
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "value1616"
      ]
    },
    "SourcePageProfile": {
      "type": "string",
      "enum": [
        "drawingml-static-solid-page-v1-draft"
      ]
    },
    "SourcePageRequest": {
      "type": "object",
      "properties": {
        "colorContext": {
          "$ref": "#/$defs/ColorContext"
        },
        "expectedSourceSha256": {
          "$ref": "#/$defs/Digest"
        },
        "profile": {
          "$ref": "#/$defs/SourcePageProfile"
        },
        "slide": {
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/RasterViewport"
        }
      },
      "additionalProperties": false,
      "required": [
        "expectedSourceSha256",
        "slide",
        "profile",
        "viewport",
        "colorContext"
      ]
    },
    "Ticks": {
      "description": "Signed int64 ticks. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "Timescale": {
      "type": "integer",
      "maximum": 1000000000,
      "minimum": 1
    },
    "TypefaceMappingPolicy": {
      "oneOf": [
        {
          "description": "The native typeface must exactly match the selected verified family name.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exactFamily"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Explicit host-supplied substitution contract. A digest is evidence identity,\nnot proof of user permission, font licensing or layout equivalence.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "substitution"
            },
            "profileSha256": {
              "$ref": "#/$defs/Digest"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "profileSha256",
            "reason"
          ]
        }
      ]
    }
  }
}
