{
  "$id": "urn:musteroffice:runtime:0.1-draft:paragraph-shape-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParagraphShapeResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ParagraphShapeResult"
        },
        "status": {
          "type": "string",
          "const": "evaluated"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ShapeFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "BidiLine": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/TextBoundary"
        },
        "levels": {
          "description": "L1-adjusted levels, one per scalar in this line. X9 entries remain None.",
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "start": {
          "$ref": "#/$defs/TextBoundary"
        },
        "visualOrder": {
          "description": "L2 visual-to-logical scalar indices relative to the full paragraph.\nX9 entries are omitted. This is not a glyph/cluster painting order (L3/L4).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "levels",
        "visualOrder"
      ]
    },
    "BidiParagraphResult": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BidiLine"
          }
        },
        "paragraphLevel": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "resolvedLevels": {
          "description": "I1/I2 result, before line-specific L1 resets. None means removed by X9.",
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "paragraphLevel",
        "resolvedLevels",
        "lines"
      ]
    },
    "CoverageOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "glyphId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "mapped"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "glyphId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unsupportedVariation"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "noUnicodeCmap"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Direction": {
      "type": "string",
      "enum": [
        "leftToRight",
        "rightToLeft",
        "topToBottom",
        "bottomToTop"
      ]
    },
    "EffectiveVariation": {
      "type": "object",
      "properties": {
        "effectiveF32Bits": {
          "description": "Effective IEEE754 binary32 design coordinate. Rounding is explicit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "requested1616": {
          "type": "integer",
          "format": "int32"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "requested1616",
        "effectiveF32Bits"
      ]
    },
    "FallbackItem": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fragments": {
          "description": "Exhaustive, disjoint, logical ranges; not visual painting order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FontFragment"
          }
        },
        "probes": {
          "description": "Whole-item probe evidence, in the caller's candidate order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FontAttempt"
          }
        },
        "protectedBoundaries": {
          "description": "Grapheme boundaries disallowed by observed clusters/unsafe-to-break.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "reshapeRejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReshapeRejection"
          }
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "probes",
        "protectedBoundaries",
        "reshapeRejections",
        "fragments"
      ]
    },
    "FallbackResult": {
      "type": "object",
      "properties": {
        "componentCalls": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "contextScalars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FallbackItem"
          }
        },
        "probedGlyphs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "shapingRuns": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "verifiedFaces": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "items",
        "verifiedFaces",
        "shapingRuns",
        "componentCalls",
        "contextScalars",
        "probedGlyphs"
      ]
    },
    "FontAttempt": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "font": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "missingGlyphClusters": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "variationIssues": {
          "description": "Conservative cmap-14 evidence, not proof of GSUB-only selector handling.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariationIssue"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "candidate",
        "font",
        "missingGlyphClusters",
        "variationIssues"
      ]
    },
    "FontFragment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "candidate": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "font": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "shaped": {
              "$ref": "#/$defs/ShapedText"
            },
            "start": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "selected"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "start",
            "end",
            "font",
            "candidate",
            "shaped"
          ]
        },
        {
          "type": "object",
          "properties": {
            "end": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "start": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "const": "unresolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "start",
            "end"
          ]
        }
      ]
    },
    "FontSelectionFailure": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "$ref": "#/$defs/FontStyle"
        },
        "reason": {
          "$ref": "#/$defs/FontSelectionReason"
        },
        "style": {
          "description": "Index in the actual ManifestParagraphInput.styles, not a native run id.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "typeface": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "style",
        "typeface",
        "fontStyle",
        "reason"
      ]
    },
    "FontSelectionReason": {
      "type": "string",
      "enum": [
        "unmappedTypeface",
        "missingStyle"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "regular",
        "bold",
        "italic",
        "boldItalic"
      ]
    },
    "ItemizationNotice": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/ItemizationNoticeKind"
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "kind"
      ]
    },
    "ItemizationNoticeKind": {
      "type": "string",
      "enum": [
        "mixedScriptCluster",
        "mixedLevelCluster",
        "ambiguousScript"
      ]
    },
    "ItemizationResult": {
      "type": "object",
      "properties": {
        "bidi": {
          "$ref": "#/$defs/BidiParagraphResult"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemizationNotice"
          }
        },
        "profile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "bidi",
        "items",
        "notices"
      ]
    },
    "ParagraphShapeResult": {
      "type": "object",
      "properties": {
        "fallback": {
          "$ref": "#/$defs/FallbackResult"
        },
        "itemization": {
          "$ref": "#/$defs/ItemizationResult"
        },
        "profile": {
          "type": "string"
        },
        "shapedItemIndices": {
          "description": "One index per cascade result. Layout controls are present only in the\nitemization; their source text remains in every shaping context.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "itemization",
        "shapedItemIndices",
        "fallback"
      ]
    },
    "ReshapeRejection": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "missingGlyphClusters": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "variationIssues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariationIssue"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "candidate",
        "missingGlyphClusters",
        "variationIssues"
      ]
    },
    "Script": {
      "type": "string",
      "enum": [
