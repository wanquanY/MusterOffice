    "ShapeFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ShapeFailureCode"
        },
        "fontSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontSelectionFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ShapeFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "FONT_INVALID",
        "UNSUPPORTED",
        "RESOURCE_CONFLICT",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "COMPONENT_FAILURE",
        "COMPONENT_INVALID",
        "HOST_FAILURE"
      ]
    },
    "ShapedGlyph": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glyphId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "safeToInsertTatweel": {
          "type": "boolean"
        },
        "unsafeToBreak": {
          "type": "boolean"
        },
        "unsafeToConcat": {
          "type": "boolean"
        },
        "xAdvance": {
          "type": "integer",
          "format": "int32"
        },
        "xOffset": {
          "type": "integer",
          "format": "int32"
        },
        "yAdvance": {
          "type": "integer",
          "format": "int32"
        },
        "yOffset": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "glyphId",
        "cluster",
        "unsafeToBreak",
        "unsafeToConcat",
        "safeToInsertTatweel",
        "xAdvance",
        "yAdvance",
        "xOffset",
        "yOffset"
      ]
    },
    "ShapedRun": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "effectiveVariations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectiveVariation"
          }
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "glyphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapedGlyph"
          }
        },
        "missingGlyphClusters": {
          "description": "A computational success may still contain missing glyphs; never hide it.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "direction",
        "effectiveVariations",
        "missingGlyphClusters",
        "glyphs"
      ]
    },
    "ShapedText": {
      "type": "object",
      "properties": {
        "faceIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fontSha256": {
          "$ref": "#/$defs/Digest"
        },
        "positionUnitsPerEm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapedRun"
          }
        },
        "unitsPerEm": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "fontSha256",
        "faceIndex",
        "unitsPerEm",
        "positionUnitsPerEm",
        "profile",
        "runs"
      ]
    },
    "TextBoundary": {
      "type": "object",
      "properties": {
        "scalarOffset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "utf16Offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "utf8Offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "scalarOffset",
        "utf8Offset",
        "utf16Offset"
      ]
    },
    "TextItem": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/TextBoundary"
        },
        "kind": {
          "$ref": "#/$defs/TextItemKind"
        },
        "level": {
          "description": "Before line-specific L1 resets; not a final glyph painting order.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "script": {
          "$ref": "#/$defs/Script"
        },
        "start": {
          "$ref": "#/$defs/TextBoundary"
        },
        "style": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "style",
        "script",
        "level",
        "kind"
      ]
    },
    "TextItemKind": {
      "type": "string",
      "enum": [
        "text",
        "tab",
        "lineBreak",
        "paragraphBreak",
        "bidiControl"
      ]
    },
    "VariationIssue": {
      "type": "object",
      "properties": {
        "baseOffset": {
          "description": "None for a selector without an immediately preceding non-selector scalar.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/CoverageOutcome"
        },
        "selectorOffset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "selectorOffset",
        "outcome"
      ]
    }
  }
}
