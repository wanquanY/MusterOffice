{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-chart-paint-query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceChartPaintQuery",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/ColorContext"
