{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-image-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PptxImagesResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "images": {
          "$ref": "#/$defs/SourceImageResources"
        },
        "status": {
          "type": "string",
          "const": "inspected"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "images"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/PptxFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "ByteLength": {
      "description": "Canonical uint64 byte length. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-integer-maximum": "18446744073709551615",
      "x-integer-minimum": "0"
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "EffectiveFillRect": {
      "type": "object",
      "properties": {
        "bottom": {
          "$ref": "#/$defs/FillValue3"
        },
        "declaredBy": {
          "$ref": "#/$defs/FillOrigin"
        },
        "left": {
          "$ref": "#/$defs/FillValue3"
        },
        "right": {
          "$ref": "#/$defs/FillValue3"
        },
        "top": {
          "$ref": "#/$defs/FillValue3"
        }
      },
      "additionalProperties": false,
      "required": [
        "declaredBy",
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "EffectiveFillTile": {
      "type": "object",
      "properties": {
        "alignment": {
          "$ref": "#/$defs/FillValue6"
        },
        "flip": {
          "$ref": "#/$defs/FillValue5"
        },
        "scaleX": {
          "$ref": "#/$defs/FillValue3"
        },
        "scaleY": {
          "$ref": "#/$defs/FillValue3"
        },
        "translateX": {
          "$ref": "#/$defs/FillValue4"
        },
        "translateY": {
          "$ref": "#/$defs/FillValue4"
        }
      },
      "additionalProperties": false,
      "required": [
        "translateX",
        "translateY",
        "scaleX",
        "scaleY",
        "flip",
        "alignment"
      ]
    },
    "EffectiveImageFill": {
      "type": "object",
      "properties": {
        "compression": {
          "$ref": "#/$defs/FillValue2"
        },
        "dpi": {
          "$ref": "#/$defs/FillValue7"
        },
        "embed": {
          "description": "Each relationship belongs to the part in its own declaring origin.\nEmpty strings are explicit or profile-default empty relationship IDs.",
          "$ref": "#/$defs/FillValue"
        },
        "link": {
          "$ref": "#/$defs/FillValue"
        },
        "mode": {
          "$ref": "#/$defs/EffectiveImageMode"
        },
        "rotateWithShape": {
          "$ref": "#/$defs/FillValue8"
        },
        "sourceRect": {
          "$ref": "#/$defs/EffectiveFillRect"
        }
      },
      "additionalProperties": false,
      "required": [
        "embed",
        "link",
        "compression",
        "sourceRect",
        "mode",
        "dpi",
        "rotateWithShape"
      ]
    },
    "EffectiveImageMode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "declaredBy": {
              "$ref": "#/$defs/FillOrigin"
            },
            "kind": {
              "type": "string",
              "const": "tile"
            },
            "tile": {
              "$ref": "#/$defs/EffectiveFillTile"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "declaredBy",
            "tile"
          ]
        },
        {
          "type": "object",
          "properties": {
            "declaredBy": {
              "$ref": "#/$defs/FillOrigin"
            },
            "fillRect": {
              "$ref": "#/$defs/EffectiveFillRect"
            },
            "kind": {
              "type": "string",
              "const": "stretch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "declaredBy",
            "fillRect"
          ]
        }
      ]
    },
    "EncodedImageResource": {
      "type": "object",
      "properties": {
        "byteLength": {
          "$ref": "#/$defs/ByteLength"
        },
        "contentType": {
          "type": "string"
        },
        "offset": {
          "description": "Contiguous offset in the separately extracted encoded-resource bundle.",
          "$ref": "#/$defs/ByteLength"
        },
        "part": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "part",
        "contentType",
        "sha256",
        "byteLength",
        "offset"
      ]
    },
    "FillOrigin": {
      "oneOf": [
        {
          "type": "object",
