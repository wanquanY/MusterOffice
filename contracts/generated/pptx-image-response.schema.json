    "ImageSourceSelection": {
      "description": "Explicit source policy. An embedded snapshot is never silently substituted\nfor a requested linked source, nor does inspection grant network authority.",
      "type": "string",
      "enum": [
        "embeddedSnapshot",
        "linkedSource"
      ]
    },
    "NativeBlipCompression": {
      "type": "string",
      "enum": [
        "email",
        "screen",
        "print",
        "hqprint",
        "none"
      ]
    },
    "NativeCoordinate": {
      "description": "Native coordinate: bounded integer EMU or exact decimal universal measure.",
      "type": "string",
      "not": {
        "pattern": "[^0-9+.a-z\\-]"
      },
      "pattern": "^([+-]?[0-9]+|-?[0-9]+(\\.[0-9]+)?(mm|cm|in|pt|pc|pi))$"
    },
    "NativeFillAlignment": {
      "type": "string",
      "enum": [
        "tl",
