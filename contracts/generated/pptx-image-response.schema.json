              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "nativeId"
          ]
        },
        {
          "description": "A real table-style declaration instantiated by this native table. None\nselects tblBg. Also identifies the exact lazy phClr reference context.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tableStyleFill"
            },
            "nativeId": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "region": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TableStyleRegion"
