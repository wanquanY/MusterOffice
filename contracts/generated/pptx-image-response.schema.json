          "additionalProperties": false,
          "required": [
            "kind",
            "part",
            "sourceOrdinal",
            "via",
            "referenceOrdinal",
            "styleIndex"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
