              "type": "string",
              "const": "theme"
            },
            "part": {
              "type": "string"
            },
            "referenceOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "sourceOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "styleIndex": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
