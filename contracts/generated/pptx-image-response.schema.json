            },
            "part": {
              "type": "string"
            },
            "sourceOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "via": {
              "$ref": "#/$defs/FillOwner"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "part",
            "sourceOrdinal",
            "via"
