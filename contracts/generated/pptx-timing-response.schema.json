{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-timing-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PptxTimingResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "inspected"
        },
        "timing": {
          "$ref": "#/$defs/SourceTiming"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "timing"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/PptxFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "ContainerDuration": {
      "oneOf": [
        {
          "description": "End when every child has ended; an untriggered child keeps it unresolved.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automatic"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration": {
              "$ref": "#/$defs/RationalTime"
            },
            "kind": {
              "type": "string",
              "const": "fixed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "duration"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "indefinite"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ContainerKind": {
      "type": "string",
      "enum": [
        "parallel",
        "sequence"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Effect": {
      "oneOf": [
        {
          "description": "Absolute local rotation in native 1/60000 degree units, including multi-turn.\nReplacement behavior; later activation wins, author order breaks ties.",
          "type": "object",
          "properties": {
            "composition": {
              "$ref": "#/$defs/RotationComposition"
            },
            "from": {
              "type": "integer",
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "const": "rotation"
            },
            "target": {
              "$ref": "#/$defs/ObjectId"
            },
            "to": {
              "type": "integer",
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "from",
            "to"
          ]
        },
        {
          "description": "Object-local scale factors in thousandths of a percent. 100000 is\nidentity, zero collapses an axis. Independent of the rotation channel.",
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/ScaleValue"
            },
            "kind": {
              "type": "string",
              "const": "scale"
            },
            "target": {
              "$ref": "#/$defs/ObjectId"
            },
            "to": {
              "$ref": "#/$defs/ScaleValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "from",
            "to"
          ]
        },
        {
          "description": "Fixed property replacement while active or held. Before activation and\nafter removal, the underlying document/animation value is unchanged.\nThis does not imply the initial-hidden state of an entrance preset.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "setVisibility"
            },
            "target": {
              "$ref": "#/$defs/ObjectId"
            },
            "value": {
              "$ref": "#/$defs/Visibility"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "value"
          ]
        },
        {
          "description": "Straight native motion path, in slide fractions relative to the original\nlayout center. Translation is in slide axes, independent of local scale\nand rotation. This is not a multi-segment/curve path approximation.",
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/MotionPoint"
            },
            "kind": {
              "type": "string",
              "const": "motionLine"
            },
            "target": {
              "$ref": "#/$defs/ObjectId"
            },
            "to": {
              "$ref": "#/$defs/MotionPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "from",
            "to"
          ]
        },
        {
          "description": "Connected lines and cubic Beziers, paced by normalized path length.\nThe original control points are retained for native editable export.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "motionPath"
            },
            "path": {
              "$ref": "#/$defs/MotionPath"
            },
            "target": {
              "$ref": "#/$defs/ObjectId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "path"
          ]
        },
        {
          "description": "Native whole-object fade filter. Progress is supplied by the behavior\nclock; visibility remains an independent channel, including preset helpers.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fade"
            },
            "target": {
              "$ref": "#/$defs/ObjectId"
            },
            "transition": {
              "$ref": "#/$defs/FadeTransition"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "transition"
          ]
        }
      ]
    },
    "FadeTransition": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ]
    },
    "FillMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "remove",
            "freeze"
          ]
        },
        {
          "description": "Unlike freeze, persists when the next sequence sibling starts.",
          "type": "string",
          "const": "hold"
        }
      ]
    },
    "MotionCoordinate": {
      "description": "Exact decimal fraction of the slide dimension; canonicalized without rounding.",
      "type": "string",
      "maxLength": 29,
      "not": {
        "pattern": "[^0-9.\\-]"
      },
      "pattern": "^-?(0|[1-9][0-9]{0,8})(\\.[0-9]{1,18})?$"
    },
    "MotionPath": {
      "description": "Connected native path. Coordinates are absolute offsets from the original\nlayout center, measured in slide fractions. Pacing uses length in this\nnormalized coordinate space, before scaling the axes to slide dimensions.",
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/MotionPoint"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MotionSegment"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "segments"
      ]
    },
    "MotionPoint": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/MotionCoordinate"
        },
        "y": {
          "$ref": "#/$defs/MotionCoordinate"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "MotionSegment": {
      "description": "Source control points remain editable; subdivision belongs only to the\nimmutable playback plan. Close returns to the initial `from` point.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "line"
            },
            "to": {
              "$ref": "#/$defs/MotionPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control1": {
              "$ref": "#/$defs/MotionPoint"
            },
            "control2": {
              "$ref": "#/$defs/MotionPoint"
            },
            "kind": {
              "type": "string",
              "const": "cubic"
            },
            "to": {
              "$ref": "#/$defs/MotionPoint"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "control1",
            "control2",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "close"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "NativeTimeline": {
      "type": "object",
      "properties": {
        "nodeBindings": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          }
        },
        "objectBindings": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          }
        },
        "rootId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timeline": {
          "$ref": "#/$defs/Timeline"
        }
      },
      "additionalProperties": false,
      "required": [
        "rootId",
        "timeline",
        "nodeBindings",
        "objectBindings"
      ]
    },
    "NavigationDirection": {
      "type": "string",
      "enum": [
        "next",
        "previous"
      ]
    },
    "NextAction": {
      "type": "string",
      "enum": [
        "none",
        "seek"
      ]
    },
    "NodeEvent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "end",
            "onEnd"
          ]
        },
        {
          "description": "A dependency on the referenced node's interval boundary.",
          "type": "string",
          "const": "begin"
        },
        {
          "description": "A lifecycle notification delivered by the referenced timing node.\nThis is not an event on a shape or another external event target.\nPreserve the native distinction: presentation editors use onBegin to\nrecognize an automatic group attached to a main sequence.",
          "type": "string",
          "const": "onBegin"
        }
      ]
    },
    "ObjectId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "PptxFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PptxFailureCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "PptxFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "SOURCE_CONFLICT",
        "PRESERVATION_CONFLICT",
        "MAPPING_NOT_IMPLEMENTED",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "READ_FAILED"
      ]
    },
    "PresentationPreset": {
      "type": "string",
      "enum": [
        "appear",
        "disappear",
        "spin",
        "growShrink",
        "customMotion",
        "fadeIn",
        "fadeOut"
      ]
    },
    "PresentationRole": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mainSequence"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "effect"
            },
            "preset": {
              "$ref": "#/$defs/PresentationPreset"
            },
            "trigger": {
              "$ref": "#/$defs/PresentationTrigger"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "preset",
            "trigger"
          ]
        }
      ]
    },
    "PresentationTrigger": {
      "type": "string",
      "enum": [
        "click",
        "withPrevious",
        "afterPrevious"
      ]
    },
    "PreviousAction": {
      "type": "string",
      "enum": [
        "none",
        "skipTimed"
      ]
    },
    "RationalTime": {
      "description": "Exact wire representation. Equality compares author values; compare_time compares instants.",
      "type": "object",
      "properties": {
        "ticks": {
          "$ref": "#/$defs/Ticks"
        },
        "timescale": {
          "$ref": "#/$defs/Timescale"
        }
      },
      "additionalProperties": false,
      "required": [
        "ticks",
        "timescale"
      ]
    },
    "RepeatCount": {
      "description": "Finite values retain the existing integer wire form. Infinity is a named\nalternative, never a sentinel count or a pre-expanded list of iterations.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "indefinite"
          ]
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ]
    },
    "RepeatDuration": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "indefinite"
          ]
        },
        {
          "$ref": "#/$defs/RationalTime"
        }
      ]
    },
    "RestartMode": {
      "description": "Admission of new begin instances within one parent activation. Ancestor\nreactivation resets this policy, including `Never`. Omission preserves the\nexisting draft's once-per-parent behavior, independently of native defaults.",
      "type": "string",
      "enum": [
        "never",
        "always",
        "whenNotActive"
      ]
    },
    "RotationComposition": {
      "description": "Rotation is composed before object/group placement. Layout replaces earlier\nanimation offsets while preserving the document's local orientation. Add\nsums the sampled offset with the lower-priority visible rotation stack.",
      "type": "string",
      "enum": [
        "absolute",
        "layout",
        "add"
      ]
    },
    "ScaleValue": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "SequenceNavigation": {
      "description": "Sequence controls are document computation, independent of host buttons or\nkeyboard bindings. Conditions are disjunctions, like begin/end conditions.",
      "type": "object",
      "properties": {
        "concurrent": {
          "type": "boolean"
        },
        "nextAction": {
          "$ref": "#/$defs/NextAction"
        },
        "nextConditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeCondition"
          }
        },
        "previousAction": {
          "$ref": "#/$defs/PreviousAction"
        },
        "previousConditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeCondition"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "concurrent",
        "nextAction",
        "previousAction",
        "nextConditions",
        "previousConditions"
      ]
    },
    "SourceTiming": {
      "type": "object",
      "properties": {
        "native": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeTimeline"
            },
            {
              "type": "null"
            }
          ]
        },
        "partSha256": {
          "$ref": "#/$defs/Digest"
        },
        "slide": {
          "type": "string"
        },
        "sourceSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "slide",
        "partSha256"
      ]
    },
    "StartCondition": {
      "description": "A flat disjunction of native begin conditions. The single-condition wire\nrepresentation remains unchanged; alternatives cannot recursively nest.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TimeCondition"
              },
              "minItems": 1
            },
            "kind": {
              "type": "string",
              "const": "anyOf"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "conditions"
          ]
        },
        {
          "$ref": "#/$defs/TimeCondition"
        }
      ]
    },
    "Ticks": {
      "description": "Signed int64 ticks. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "TimeCondition": {
      "oneOf": [
        {
          "description": "An explicitly indefinite condition, never a fabricated zero-time event.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "never"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "at"
            },
            "offset": {
              "$ref": "#/$defs/RationalTime"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "offset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delay": {
              "$ref": "#/$defs/RationalTime"
            },
            "event": {
              "$ref": "#/$defs/NodeEvent"
            },
            "kind": {
              "type": "string",
              "const": "after"
            },
            "node": {
              "$ref": "#/$defs/TimingNodeId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "node",
            "event",
            "delay"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delay": {
              "$ref": "#/$defs/RationalTime"
            },
            "kind": {
              "type": "string",
              "const": "click"
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ObjectId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "delay"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delay": {
              "$ref": "#/$defs/RationalTime"
            },
            "direction": {
              "$ref": "#/$defs/NavigationDirection"
            },
            "kind": {
              "type": "string",
              "const": "navigation"
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ObjectId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "direction",
            "delay"
          ]
        }
      ]
    },
    "TimeTransform": {
      "description": "Local behavior clock. Percentages use native thousandths of one percent;\n100000 speed is normal playback. The clock is independent of effect values.",
      "type": "object",
      "properties": {
        "accelerationMilliPercent": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "autoReverse": {
          "type": "boolean"
        },
        "decelerationMilliPercent": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "speedMilliPercent": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "speedMilliPercent",
        "autoReverse",
        "accelerationMilliPercent",
        "decelerationMilliPercent"
      ]
    },
    "Timeline": {
      "description": "Behaviors plus an optional explicit timing forest. The legacy graph retains\nits byte representation; version 0.2 owns every behavior through tree roots.",
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TimelineVersion"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimingNode"
          }
        },
        "tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimingTree"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "nodes"
      ]
    },
    "TimelineVersion": {
      "type": "string",
      "enum": [
        "musteroffice.timeline/0.1-draft",
        "musteroffice.timeline/0.2-draft"
      ]
    },
    "Timescale": {
      "type": "integer",
      "maximum": 1000000000,
      "minimum": 1
    },
    "TimingContainer": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimingNodeId"
          }
        },
        "duration": {
          "$ref": "#/$defs/ContainerDuration"
        },
        "endConditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeCondition"
          }
        },
        "fill": {
          "$ref": "#/$defs/FillMode"
        },
        "id": {
          "$ref": "#/$defs/TimingNodeId"
        },
        "kind": {
          "$ref": "#/$defs/ContainerKind"
        },
        "navigation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequenceNavigation"
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation": {
          "description": "Native presentation identity. It participates in initial playback state\nand editable export; it never changes the container's declared clock.",
          "anyOf": [
            {
              "$ref": "#/$defs/PresentationRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "restart": {
          "$ref": "#/$defs/RestartMode"
        },
        "start": {
          "$ref": "#/$defs/StartCondition"
        },
        "timeTransform": {
          "description": "Filter the container's simple time before its descendants consume it.\nCompilation validates the supported clock domain; this is never copied\ninto the leaves or interpreted as an independent per-effect easing.",
          "anyOf": [
            {
              "$ref": "#/$defs/TimeTransform"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "start",
        "duration",
        "fill",
        "children"
      ]
    },
    "TimingNode": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/RationalTime"
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "endConditions": {
          "description": "Earliest resolved eligible end; absent conditions add no end constraint.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeCondition"
          }
        },
        "fill": {
          "$ref": "#/$defs/FillMode"
        },
        "id": {
          "$ref": "#/$defs/TimingNodeId"
        },
        "repeatDuration": {
          "description": "Additional bound in local active time, before speed scaling.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepeatDuration"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeatMilli": {
          "description": "Native count in thousandths, or explicit indefinite repetition.",
          "$ref": "#/$defs/RepeatCount"
        },
        "restart": {
          "$ref": "#/$defs/RestartMode"
        },
        "start": {
          "$ref": "#/$defs/StartCondition"
        },
        "timeTransform": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeTransform"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "duration",
        "repeatMilli",
        "fill",
        "effect"
      ]
    },
    "TimingNodeId": {
      "type": "string",
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "TimingTree": {
      "type": "object",
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimingContainer"
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimingNodeId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "roots",
        "containers"
      ]
    },
    "Visibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ]
    }
  }
}
