{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-placement-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PptxPlacementResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "placements": {
          "$ref": "#/$defs/SourcePlacements"
        },
        "status": {
          "type": "string",
          "const": "evaluated"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "placements"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/PptxFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "Affine": {
      "description": "Evaluated affine transform, not author rotation/flip/viewport semantics.",
      "type": "object",
      "properties": {
        "linear": {
          "description": "Dimensionless Q32 in row-major order: xx, xy, yx, yy.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedQ32"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "translation": {
          "description": "Q32 in the same coordinate unit as the input point.",
          "$ref": "#/$defs/Point2"
        }
      },
      "additionalProperties": false,
      "required": [
        "linear",
        "translation"
      ]
    },
    "AffineUncertainty": {
      "type": "object",
      "properties": {
        "linear": {
          "description": "Nonnegative outward bounds, raw dimensionless Q32.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedQ32"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "translation": {
          "description": "Nonnegative outward bounds, raw Q32 EMU.",
          "$ref": "#/$defs/Point2"
        }
      },
      "additionalProperties": false,
      "required": [
        "linear",
        "translation"
      ]
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "Emu": {
      "description": "Signed int64 EMU. 1 point = 12700 EMU. Range requires semantic validation.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-integer-maximum": "9223372036854775807",
      "x-integer-minimum": "-9223372036854775808"
    },
    "FixedQ32": {
      "description": "Signed i128 integer divided by 2^32. Coordinate unit is specified by the owning geometry profile; semantic range validation required.",
      "type": "string",
      "not": {
        "pattern": "[^0-9-]"
      },
      "pattern": "^(0|-?[1-9][0-9]{0,38})$",
      "x-integer-maximum": "170141183460469231731687303715884105727",
      "x-integer-minimum": "-170141183460469231731687303715884105728"
    },
    "NativeObjectPlacement": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "nativeId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/SourcePlacementOutcome"
        },
        "parentGroup": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "nativeId",
        "depth",
        "outcome"
      ]
    },
    "NativePlacement": {
      "type": "object",
      "properties": {
        "affine": {
          "description": "Already in surface coordinates; subtract anchor, then apply once.",
          "$ref": "#/$defs/Affine"
        },
        "anchor": {
          "$ref": "#/$defs/Point2"
        },
        "sourceOrigin": {
          "$ref": "#/$defs/Point"
        },
        "sourceSize": {
          "description": "Effective coordinate viewport. A zero/missing group child extent uses\nthe corresponding target extent, producing unit scale on that axis.",
          "$ref": "#/$defs/Size"
        },
        "transform": {
          "$ref": "#/$defs/ResolvedNativeTransform"
        },
        "uncertainty": {
          "$ref": "#/$defs/AffineUncertainty"
        }
      },
      "additionalProperties": false,
      "required": [
        "transform",
        "sourceSize",
        "sourceOrigin",
        "anchor",
        "affine",
        "uncertainty"
      ]
    },
    "PlaceholderMatchRule": {
      "type": "string",
      "enum": [
        "slideIndex",
        "masterType"
      ]
    },
    "PlacementCause": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missingOrigin"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missingSize"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inheritance"
            },
            "status": {
              "$ref": "#/$defs/SourcePlaceholderMatch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "retainedTransform"
            },
            "sourceOrdinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sourceOrdinal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "invalidCoordinate"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "field"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "numericRange"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PlacementUnresolved": {
      "type": "object",
      "properties": {
        "cause": {
          "$ref": "#/$defs/PlacementCause"
        },
        "object": {
          "$ref": "#/$defs/SourceObjectRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "object",
        "cause"
      ]
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/Emu"
        },
        "y": {
          "$ref": "#/$defs/Emu"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "Point2": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/FixedQ32"
        },
        "y": {
          "$ref": "#/$defs/FixedQ32"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "PptxFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/PptxFailureCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "PptxFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "SOURCE_CONFLICT",
        "PRESERVATION_CONFLICT",
        "MAPPING_NOT_IMPLEMENTED",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "READ_FAILED"
      ]
    },
    "ResolvedNativeTransform": {
      "type": "object",
      "properties": {
        "childOrigin": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "childSize": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformValue2"
            },
            {
              "type": "null"
            }
          ]
        },
        "flipHorizontal": {
          "$ref": "#/$defs/TransformValue4"
        },
        "flipVertical": {
          "$ref": "#/$defs/TransformValue4"
        },
        "graphicFrameOrientationIgnored": {
          "description": "Office ignores a graphic frame's own orientation attributes; parent\ngroup orientation still applies. The original values remain above.",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/TransformValue"
        },
        "rotation": {
          "$ref": "#/$defs/TransformValue3"
        },
        "size": {
          "$ref": "#/$defs/TransformValue2"
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "size",
        "rotation",
        "flipHorizontal",
        "flipVertical",
        "graphicFrameOrientationIgnored"
      ]
    },
    "Size": {
      "type": "object",
      "properties": {
        "height": {
          "$ref": "#/$defs/Emu"
        },
        "width": {
          "$ref": "#/$defs/Emu"
        }
      },
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ]
    },
    "SourceObjectRef": {
      "type": "object",
      "properties": {
        "nativeId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "part": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "part",
        "nativeId"
      ]
    },
    "SourcePlaceholderMatch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "notPlaceholder"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "master"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rule": {
              "$ref": "#/$defs/PlaceholderMatchRule"
            },
            "status": {
              "type": "string",
              "const": "matched"
            },
            "target": {
              "$ref": "#/$defs/SourceObjectRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "target",
            "rule"
          ]
        },
        {
          "description": "Missing relationship or matching placeholder; no synthetic geometry.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unmatched"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        },
        {
          "description": "Slide idx=0xffffffff is explicitly detached from layout matching.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "detached"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "part": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "ambiguous"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "part",
            "candidates"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unsupportedContext"
            }
          },
          "additionalProperties": false,
          "required": [
            "status"
          ]
        }
      ]
    },
    "SourcePlacementOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "placement": {
              "$ref": "#/$defs/NativePlacement"
            },
            "status": {
              "type": "string",
              "const": "resolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "placement"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/PlacementUnresolved"
            },
            "status": {
              "type": "string",
              "const": "unresolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "SourcePlacementProfile": {
      "type": "string",
      "enum": [
        "drawingml-source-sector-scale-q96-v1-draft"
      ]
    },
    "SourcePlacements": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeObjectPlacement"
          }
        },
        "profile": {
          "$ref": "#/$defs/SourcePlacementProfile"
        },
        "rootTransformIgnored": {
          "description": "Presentation spTree transform declarations are retained but do not move\npage contents in this profile. Nested grpSp transforms do participate.",
          "type": "boolean"
        },
        "sourceSha256": {
          "$ref": "#/$defs/Digest"
        },
        "surface": {
          "type": "string"
        },
        "uniqueAngles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "surface",
        "profile",
        "rootTransformIgnored",
        "objects",
        "uniqueAngles"
      ]
    },
    "TransformValue": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TransformValueSource"
        },
        "value": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ]
    },
    "TransformValue2": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TransformValueSource"
        },
        "value": {
          "$ref": "#/$defs/Size"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ]
    },
    "TransformValue3": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TransformValueSource"
        },
        "value": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ]
    },
    "TransformValue4": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TransformValueSource"
        },
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ]
    },
    "TransformValueSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "declaration"
            },
            "object": {
              "$ref": "#/$defs/SourceObjectRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "object"
          ]
        },
        {
          "description": "Schema/profile default at the selected transform's owner.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "default"
            },
            "object": {
              "$ref": "#/$defs/SourceObjectRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "object"
          ]
        }
      ]
    }
  }
}
