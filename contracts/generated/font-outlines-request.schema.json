{
  "$id": "urn:musteroffice:runtime:0.1-draft:font-outlines-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FontOutlinesRequest",
  "type": "object",
  "properties": {
    "expectedSha256": {
      "$ref": "#/$defs/Digest"
    },
    "faceIndex": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutlineInstance"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "expectedSha256",
    "faceIndex",
    "instances"
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "OutlineInstance": {
      "type": "object",
      "properties": {
        "glyphIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "maxCommands": {
          "description": "Aggregate across all glyphs of this instance, including discarded prefixes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxOperations": {
          "description": "HarfBuzz's weighted interpreter budget, not CPU instructions or time.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "variations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapeVariation"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "variations",
        "glyphIds",
        "maxCommands",
        "maxOperations"
      ]
    },
    "ShapeVariation": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "value1616": {
          "description": "Exact requested OpenType 16.16 design coordinate.",
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "value1616"
      ]
    }
  }
}
