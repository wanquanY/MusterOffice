{
  "$id": "urn:musteroffice:runtime:0.1-draft:pptx-line-query",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceLineQuery",
  "type": "object",
  "properties": {
    "expectedSourceSha256": {
      "$ref": "#/$defs/Digest"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "profile": {
      "$ref": "#/$defs/LineProfile"
    },
    "surface": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "expectedSourceSha256",
    "surface",
    "objects",
    "profile"
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^[0-9a-f]{64}$"
    },
    "LineProfile": {
      "description": "Explicit interpretation of the documented multi-pass DrawingML rules.\nThis is not a certificate for a particular Office/WPS version or renderer.",
      "type": "string",
      "enum": [
        "ms-oi29500-lines-2024-draft-v1"
      ]
    }
  }
}
