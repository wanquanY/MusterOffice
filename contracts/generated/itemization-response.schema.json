    "ShapeFailure": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ShapeFailureCode"
        },
        "fontSelection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontSelectionFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ShapeFailureCode": {
      "type": "string",
      "enum": [
        "INPUT_INVALID",
        "FONT_INVALID",
        "UNSUPPORTED",
        "RESOURCE_CONFLICT",
        "RESOURCE_REQUIRED",
        "LIMIT_EXCEEDED",
        "CANCELLED",
        "COMPONENT_FAILURE",
        "COMPONENT_INVALID",
        "HOST_FAILURE"
      ]
    },
    "TextBoundary": {
      "type": "object",
      "properties": {
        "scalarOffset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "utf16Offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "utf8Offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "scalarOffset",
        "utf8Offset",
        "utf16Offset"
      ]
    },
    "TextItem": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/TextBoundary"
        },
        "kind": {
          "$ref": "#/$defs/TextItemKind"
        },
        "level": {
          "description": "Before line-specific L1 resets; not a final glyph painting order.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "script": {
          "$ref": "#/$defs/Script"
        },
        "start": {
          "$ref": "#/$defs/TextBoundary"
        },
        "style": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "style",
        "script",
        "level",
        "kind"
      ]
    },
    "TextItemKind": {
      "type": "string",
      "enum": [
        "text",
        "tab",
        "lineBreak",
        "paragraphBreak",
        "bidiControl"
      ]
    }
  }
}
