{
  "$id": "urn:musteroffice:runtime:0.1-draft:itemization-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemizationResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/ItemizationResult"
        },
        "status": {
          "type": "string",
          "const": "itemized"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ShapeFailure"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "error"
      ]
    }
  ],
  "$defs": {
    "BidiLine": {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/TextBoundary"
        },
        "levels": {
          "description": "L1-adjusted levels, one per scalar in this line. X9 entries remain None.",
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "start": {
          "$ref": "#/$defs/TextBoundary"
        },
        "visualOrder": {
          "description": "L2 visual-to-logical scalar indices relative to the full paragraph.\nX9 entries are omitted. This is not a glyph/cluster painting order (L3/L4).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "levels",
        "visualOrder"
      ]
    },
    "BidiParagraphResult": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BidiLine"
          }
        },
        "paragraphLevel": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "profile": {
          "type": "string"
        },
        "resolvedLevels": {
          "description": "I1/I2 result, before line-specific L1 resets. None means removed by X9.",
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "paragraphLevel",
        "resolvedLevels",
        "lines"
      ]
    },
    "FontSelectionFailure": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "$ref": "#/$defs/FontStyle"
        },
        "reason": {
          "$ref": "#/$defs/FontSelectionReason"
        },
        "style": {
          "description": "Index in the actual ManifestParagraphInput.styles, not a native run id.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "typeface": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "style",
        "typeface",
        "fontStyle",
        "reason"
      ]
    },
    "FontSelectionReason": {
      "type": "string",
      "enum": [
        "unmappedTypeface",
        "missingStyle"
      ]
    },
    "FontStyle": {
      "type": "string",
      "enum": [
        "regular",
        "bold",
        "italic",
        "boldItalic"
      ]
    },
    "ItemizationNotice": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/ItemizationNoticeKind"
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "kind"
      ]
    },
    "ItemizationNoticeKind": {
      "type": "string",
      "enum": [
        "mixedScriptCluster",
        "mixedLevelCluster",
        "ambiguousScript"
      ]
    },
    "ItemizationResult": {
      "type": "object",
      "properties": {
        "bidi": {
          "$ref": "#/$defs/BidiParagraphResult"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextItem"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemizationNotice"
          }
        },
        "profile": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile",
        "bidi",
        "items",
        "notices"
      ]
    },
